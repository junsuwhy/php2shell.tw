// Cloudflare Workers Builds 部署設定：純靜態站，只上傳 astro build 產出的 dist/。
// 有這個檔案 wrangler 就不會自動跑 `astro add cloudflare`（那會改成 SSR adapter 而 build 失敗）。
// GA Measurement ID 請設在 Worker 的 Build 變數 PUBLIC_GA_MEASUREMENT_ID，不放 repo。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "php2shell-tw",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // 非 main 分支的 PR 由 Workers Builds 執行 `npx wrangler preview` 產生預覽，需要這個區塊（可以是空的）。
  "previews": {}
}
