---
// 可直接複製傳給主機商、外包廠商或資訊人員的詢問訊息。每一頁都用同一份，改這裡就好。
import { facts } from '../../lib/data';

interface Props {
  /** 收件對象，只用在標題，例如「主機商」 */
  to?: string;
  /** 放在小節裡面時標題降級，例如 3 或 4 */
  level?: 2 | 3 | 4;
  /** 放在白色步驟卡片裡的緊湊樣式；沒指定時，level 3 用這個樣式 */
  inline?: boolean;
  /** 同一頁出現多次時給每個實例不同的前綴，標題 id 才不會重複 */
  idPrefix?: string;
}

const { to = '主機商或廠商', level = 2, inline = level === 3, idPrefix } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3' | 'h4';
const titleId = idPrefix ? `${idPrefix}-ask-title` : 'ask-title';
const cves = facts.cves.map((c) => c.id).join('、');
const text = `您好，PHP 官方在 2026-10-21 公布了重大漏洞 PHP2Shell（${cves}）。想請您協助確認我們的網站，並用文字回覆：

網站網址：（請填你的網址；舊的活動網站、測試網站也請一起列）

1. 這些網站有沒有用到 PHP？目前是哪一版？
2. 是否已更新到修補版？請提供更新後的完整版本號。如果是作業系統或主機商提供的修補套件，版本號可能比官方舊，請附上對應的安全公告編號。
3. 是哪一天、幾點更新的？
4. 更新後，PHP 和網站伺服器是否已經重新啟動？
5. 10 月 17 日以來的存取紀錄和網站檔案，有沒有檢查過？有沒有發現異常？
6. 如果今天無法完成更新，是否能先讓網站暫停對外？

謝謝！`;
---
<section class:list={['ask', { 'ask--inline': inline }]} aria-labelledby={titleId}>
  <Heading id={titleId}>直接傳給{to}的訊息</Heading>
  <p>複製下面這段，把網址填上，用 Email 或客服單傳給對方。請對方<strong>用文字回覆</strong>，之後拿回覆對照<a href="/basic/act/#done">怎樣算處理完</a>。</p>
  <figure class="ask__box">
    <figcaption>
      <span>詢問訊息</span>
      <!-- 沒有 JavaScript 時按鈕不顯示，下面的文字仍可直接選取複製 -->
      <button type="button" class="ask__copy" data-ask-copy hidden><span data-ask-copy-text>複製詢問訊息</span></button>
    </figcaption>
    <pre data-ask-text>{text}</pre>
    <p class="ask__status" role="status" aria-live="polite" data-ask-status></p>
  </figure>
</section>

<script>
  const LABEL = '複製詢問訊息';
  document.querySelectorAll<HTMLButtonElement>('[data-ask-copy]').forEach((b) => (b.hidden = false));

  // 先用 Clipboard API；不行（非 https、舊瀏覽器、權限被擋）再用舊式複製
  const copy = async (text: string) => {
    try {
      if (!navigator.clipboard) throw new Error('no clipboard');
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  };

  const timers = new WeakMap<Element, number>();

  document.addEventListener('click', async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-ask-copy]');
    if (!button) return;
    const box = button.closest('.ask__box');
    const pre = box?.querySelector('[data-ask-text]');
    const label = button.querySelector('[data-ask-copy-text]');
    const status = box?.querySelector('[data-ask-status]');
    if (!box || !pre) return;

    const ok = await copy(pre.textContent ?? '');
    window.clearTimeout(timers.get(box));
    if (ok) {
      if (label) label.textContent = '已複製 ✓';
      if (status) status.textContent = '已複製，可以貼到 Email 或客服單了。';
      timers.set(
        box,
        window.setTimeout(() => {
          if (label) label.textContent = LABEL;
          if (status) status.textContent = '';
        }, 4000),
      );
    } else {
      // 都不行就把整段文字選起來，請訪客自己複製
      const range = document.createRange();
      range.selectNodeContents(pre);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      if (label) label.textContent = LABEL;
      if (status) status.textContent = '沒辦法自動複製。訊息已經幫你選取好了，請按 Ctrl+C（Mac 按 ⌘+C；手機請長按選取的文字，再點「複製」）。';
    }
  });
</script>

<style>
  .ask { display: grid; gap: 12px; }
  h2,
  h3,
  h4 { font-size: 1.5rem; font-weight: 800; margin-top: 24px; }
  .ask--inline { margin-top: 16px; gap: 10px; }
  .ask--inline :is(h3, h4) { font-size: 1.1875rem; margin-top: 0; }
  .ask--inline > p { font-size: 1.0625rem; }
  /* 放在白色卡片裡時加框，訊息才不會跟卡片混在一起 */
  .ask--inline .ask__box { border: 2px solid var(--line-basic); background: var(--floor); }
  .ask__box { margin: 0; background: #fff; border-radius: 14px; overflow: hidden; }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    background: var(--line-basic);
    color: var(--on-line);
    font-weight: 800;
  }
  .ask__copy {
    min-height: 40px;
    padding: 6px 16px;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: var(--floor-ink);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .ask__copy[hidden] { display: none; }
  .ask__copy:focus-visible { outline: 3px solid var(--graphite); outline-offset: 2px; }
  .ask__status {
    margin: 0;
    padding: 10px 16px 14px;
    border-top: 1px solid var(--floor);
    color: var(--floor-ink);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.6;
  }
  /* 空的時候收起來但不移出無障礙樹，螢幕閱讀器才收得到之後的更新 */
  .ask__status:empty { padding: 0; border-top: 0; }
  pre {
    margin: 0;
    padding: 16px;
    white-space: pre-wrap;
    font-family: inherit;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
</style>
