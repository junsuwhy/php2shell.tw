---
// 非技術區共用頁面框架：標題、導言、插圖、內文，以及固定在頁尾的「下一步」。
// 樣式只作用在 .basic-page 之內，不新增全域樣式。
import Base from '../../layouts/Base.astro';
import ImageSlot from '../ImageSlot.astro';
import { getSlot } from '../../lib/images';
import NextStep, { type NextItem } from './NextStep.astro';

interface Props {
  title: string;
  heading?: string;
  description?: string;
  lead?: string;
  image?: string;
  next: NextItem[];
  back?: { href: string; label: string };
}

const { title, heading = title, description, lead, image, next, back } = Astro.props;
// 正式網站沒有圖時整個圖框不出現；開發模式顯示待產生標示。
const showFigure = image ? getSlot(image).ready || import.meta.env.DEV : false;
---
<Base title={title} description={description} persona="basic">
  <article class="basic-page">
    <header class="basic-page__head">
      {back && (
        <p class="basic-page__back"><a href={back.href}>← {back.label}</a></p>
      )}
      <h1>{heading}</h1>
      {lead && <p class="basic-page__lead">{lead}</p>}
    </header>
    {image && showFigure && (
      <figure class="basic-page__figure">
        <ImageSlot id={image} />
      </figure>
    )}
    <div class="basic-page__body">
      <slot />
    </div>
    <NextStep items={next} />
  </article>
</Base>

<style>
  .basic-page {
    max-width: 44rem;
    margin: 0 auto;
    padding: 40px var(--gutter) 64px;
    font-size: 1.1875rem;
    line-height: 1.8;
  }
  .basic-page__head {
    display: grid;
    gap: 16px;
    padding-bottom: 24px;
    border-bottom: 6px solid var(--line-basic);
  }
  .basic-page__back { font-size: 1rem; }
  .basic-page__back a { color: var(--floor-ink-soft); }
  h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .basic-page__lead {
    font-size: 1.25rem;
    color: var(--floor-ink-soft);
  }
  .basic-page__figure {
    margin: 28px 0 0;
    border-radius: 16px;
    overflow: hidden;
  }
  .basic-page__body {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }

  /* 內文元素（來自各頁 slot） */
  .basic-page__body :global(h2) {
    margin-top: 24px;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .basic-page__body :global(h3) {
    font-size: 1.25rem;
    font-weight: 800;
  }
  .basic-page__body :global(ul),
  .basic-page__body :global(ol) {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 8px;
  }
  .basic-page__body :global(strong) { font-weight: 800; }
  .basic-page__body :global(.callout) {
    padding: 20px 22px;
    border-radius: 14px;
    background: #fff;
    border-left: 8px solid var(--line-basic);
  }
  .basic-page__body :global(.callout--warn) { border-left-color: var(--alert); }
  .basic-page__body :global(.steps) {
    counter-reset: step;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .basic-page__body :global(.steps > li) {
    counter-increment: step;
    position: relative;
    padding: 16px 18px 16px 64px;
    border-radius: 14px;
    background: #fff;
  }
  .basic-page__body :global(.steps > li)::before {
    content: counter(step);
    position: absolute;
    left: 16px;
    top: 14px;
    width: 34px;
    height: 34px;
    display: grid;
    place-content: center;
    border-radius: 50%;
    background: var(--line-basic);
    color: var(--on-line);
    font-weight: 900;
    font-family: var(--font-num);
  }
  .basic-page__body :global(.path) {
    font-weight: 800;
    background: #fff;
    padding: 0 6px;
    border-radius: 6px;
    white-space: nowrap;
  }
</style>
