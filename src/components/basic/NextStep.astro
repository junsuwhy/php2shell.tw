---
// 每一頁的結尾：「下一步做什麼」。第一個項目是主要行動。
export interface NextItem {
  href: string;
  label: string;
  note?: string;
}

interface Props { items: NextItem[] }
const { items } = Astro.props;
---
<section class="next" aria-labelledby="next-title">
  <h2 id="next-title">下一步做什麼</h2>
  <ul>
    {items.map((item, i) => (
      <li>
        <a href={item.href} class:list={['next__link', { 'next__link--primary': i === 0 }]}>
          <span class="next__label">{item.label}</span>
          {item.note && <span class="next__note">{item.note}</span>}
          <span class="next__arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .next {
    margin-top: 48px;
    padding: 28px 24px;
    border-radius: 18px;
    background: var(--graphite);
    color: var(--on-graphite);
  }
  h2 {
    font-size: 1.375rem;
    font-weight: 900;
    margin-bottom: 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .next__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    align-items: center;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--graphite-2);
    color: var(--on-graphite);
    text-decoration: none;
    min-height: 56px;
  }
  .next__link--primary {
    background: var(--line-basic);
    color: var(--on-line);
  }
  .next__label { font-weight: 800; font-size: 1.125rem; }
  .next__note {
    grid-column: 1;
    font-size: 0.9375rem;
    opacity: 0.85;
  }
  .next__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1.5rem;
    font-weight: 900;
  }
  .next__link:hover .next__label,
  .next__link:focus-visible .next__label { text-decoration: underline; }
</style>
