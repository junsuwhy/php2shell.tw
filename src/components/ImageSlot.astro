---
// 圖片位置：有圖顯示圖；沒圖時開發模式顯示標示框，正式網站改用 fallback slot（沒有就不顯示）。
import { getSlot } from '../lib/images';

interface Props {
  id: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  /** 為 false 時不寫死比例，由外層控制（滿版 hero、正方形按鈕）。 */
  framed?: boolean;
}

const { id, class: className, loading = 'lazy', framed = true } = Astro.props;
const slot = getSlot(id);
const showMarker = !slot.ready && import.meta.env.DEV;
const ratio = framed ? `aspect-ratio:${slot.aspect}` : undefined;
---
{slot.ready ? (
  <img class:list={['image-slot', className]} src={slot.src} alt={slot.alt} loading={loading} decoding="async" style={ratio} />
) : showMarker ? (
  <div class:list={['image-slot', 'image-slot--pending', className]} style={ratio} role="img" aria-label={`待產生圖片：${slot.alt}`}>
    <span class="image-slot__id">IMG · {slot.id}</span>
    <span class="image-slot__meta">{slot.aspect} · {slot.where}</span>
  </div>
) : (
  <slot name="fallback" />
)}
