---
// 三區活動首頁共用骨架：滿版 hero、一句主張、一行事實副句、大按鈕。
// 長文不放這裡。視覺用該區路線色（--line-*），由 data-line 切換。
import Base from '../layouts/Base.astro';
import HeroBanner from './HeroBanner.astro';
import type { PersonaId } from '../data/personas';

export interface CampaignAction {
  href: string;
  label: string;
  /** 最該先按的那一顆，加一圈外框。 */
  primary?: boolean;
}

interface Props {
  persona: PersonaId;
  title: string;
  description?: string;
  hero: string;
  heading: string;
  actions?: CampaignAction[];
  actionsLabel?: string;
  /** 主要行動排在 hero 下方時，橫幅改矮，首屏才看得到那些按鈕。 */
  compact?: boolean;
}

const {
  persona,
  title,
  description,
  hero,
  heading,
  actions = [],
  actionsLabel = '主要行動',
  compact = false,
} = Astro.props;
---
<Base title={title} description={description} persona={persona}>
  <HeroBanner id={hero} variant={persona} campaign compact={compact}>
    <div class="campaign" data-line={persona}>
      <h1>{heading}</h1>
      <div class="campaign__sub">
        <slot name="sub" />
      </div>
      <slot name="heroExtra" />
      {actions.length > 0 && (
        <nav class="campaign__actions" aria-label={actionsLabel}>
          {actions.map((action) => (
            <a class:list={['campaign__btn', { 'campaign__btn--primary': action.primary }]} href={action.href}>
              <span class="campaign__label">{action.label}</span>
              <span class="campaign__arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      )}
    </div>
  </HeroBanner>
  {Astro.slots.has('body') && (
    <div class="campaign-body">
      <slot name="body" />
    </div>
  )}
  {Astro.slots.has('strip') && (
    <div class="campaign-strip">
      <slot name="strip" />
    </div>
  )}
</Base>

<style>
  .campaign { --campaign-line: var(--line-basic); }
  .campaign[data-line='dev'] { --campaign-line: var(--line-dev); }
  .campaign[data-line='news'] { --campaign-line: var(--line-news); }

  h1 {
    font-size: var(--fs-display);
    font-weight: 900;
    letter-spacing: 0.01em;
  }
  .campaign__sub {
    margin-top: 10px;
    max-width: 40rem;
    font-size: var(--fs-body);
    line-height: 1.45;
  }
  .campaign__actions {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }
  .campaign__btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 56px;
    padding: 12px 18px;
    border-radius: 14px;
    background: var(--campaign-line);
    color: var(--on-line);
    font-size: var(--fs-lead);
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;
  }
  .campaign__btn--primary {
    min-height: 68px;
    font-size: var(--fs-lead);
    box-shadow: 0 0 0 3px #fff, 0 0 0 6px var(--graphite);
  }
  .campaign__label { text-wrap: balance; }
  .campaign__arrow {
    flex: none;
    font-size: var(--fs-heading);
    font-weight: 900;
  }
  .campaign__btn:hover { filter: brightness(1.06); }
  .campaign__btn:hover .campaign__label,
  .campaign__btn:focus-visible .campaign__label {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }
  .campaign__btn:focus-visible {
    outline: 3px solid var(--graphite);
    outline-offset: 4px;
  }
  @media (min-width: 900px) {
    :global(.hero--campaign.hero--media) .campaign__btn:focus-visible {
      outline-color: #fff;
    }
  }
</style>
