---
// 滿版橫幅。有圖（或開發模式的佔位框）時寬度貼齊視窗；
// 桌機把標題疊在左側深色底上，手機改把標題放在圖下方。
// 正式網站沒有圖時不顯示圖框，標題照常出現。
import ImageSlot from './ImageSlot.astro';
import { getSlot } from '../lib/images';

interface Props {
  id?: string;
  /** home 沒圖時仍是深色站名牌；其餘用淺底標題。 */
  variant?: 'home' | 'basic' | 'dev' | 'news';
}

const { id, variant = 'basic' } = Astro.props;
const slot = id ? getSlot(id) : undefined;
const showMedia = Boolean(slot && (slot.ready || import.meta.env.DEV));
---
<div class:list={['hero', `hero--${variant}`, { 'hero--media': showMedia }]}>
  {showMedia && id && (
    <div class="hero__media">
      <ImageSlot id={id} class="hero__img" loading="eager" framed={false} />
    </div>
  )}
  <div class="hero__copy">
    <slot />
  </div>
</div>

<style>
  .hero--basic { --hero-max: 44rem; }
  .hero--dev { --hero-max: 46rem; }
  .hero--news { --hero-max: 46rem; }
  .hero--home {
    --hero-max: none;
    background: var(--graphite);
    color: var(--on-graphite);
  }

  .hero:not(.hero--media) .hero__copy,
  .hero--media .hero__copy {
    max-width: var(--hero-max, 46rem);
    margin: 0 auto;
    padding: 32px var(--gutter) 0;
  }
  .hero--home:not(.hero--media) .hero__copy,
  .hero--home.hero--media .hero__copy {
    max-width: none;
    padding: clamp(28px, 5vw, 56px) var(--gutter) clamp(24px, 4vw, 40px);
  }

  .hero--basic.hero--media { border-bottom: 6px solid var(--line-basic); }
  .hero--dev.hero--media { border-bottom: 6px solid var(--line-dev); }
  .hero--news.hero--media { border-bottom: 6px solid var(--line-news); }
  .hero__media { background: #121418; }
  .hero__media :global(.hero__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .hero--media {
      display: grid;
    }
    .hero--media .hero__media,
    .hero--media .hero__copy {
      grid-area: 1 / 1;
    }
    .hero__media :global(.hero__img) {
      height: 100%;
      min-height: calc(100vw * 9 / 21);
      aspect-ratio: auto;
    }
    .hero--media .hero__copy {
      z-index: 1;
      align-self: end;
      justify-self: start;
      width: min(38vw, 36rem);
      max-width: none;
      margin: 0;
      padding: clamp(24px, 4vh, 48px) 28px clamp(24px, 4vh, 48px) var(--gutter);
      color: #fff;
      /* 整塊字都壓在不透明深底上。白字對這層底，即使底下的圖是亮的，對比仍高於 4.5:1。 */
      background: rgb(14 16 20 / 0.92);
      box-shadow: 28px 0 36px rgb(14 16 20 / 0.55);
    }
    .hero--home.hero--media .hero__copy {
      width: min(42vw, 40rem);
      padding-top: clamp(36px, 6vh, 72px);
      padding-bottom: clamp(28px, 5vh, 56px);
      background: rgb(14 16 20 / 0.92);
    }
    .hero--media .hero__copy :global(h1),
    .hero--media .hero__copy :global(p),
    .hero--media .hero__copy :global(a),
    .hero--media .hero__copy :global(dt),
    .hero--media .hero__copy :global(dd) {
      color: #fff;
    }
    .hero--media .hero__copy :global(.basic-page__head) {
      border: 0;
      padding: 0;
      gap: 10px;
    }
    .hero--media .hero__copy :global(.basic-page__lead),
    .hero--media .hero__copy :global(.lede) {
      color: #f3f5f7;
    }
  }
</style>
