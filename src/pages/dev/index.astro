---
import CampaignLanding from '../../components/CampaignLanding.astro';
import VersionMatrix from '../../components/dev/VersionMatrix.astro';
import { facts, releaseClock } from '../../lib/data';

const ids = facts.cves.map((c) => c.id).join('、');
const sameScore = facts.cves.every((c) => c.cvss_v4 === facts.cves[0].cvss_v4);
const cvss = sameScore
  ? `CVSS v4.0 ${facts.cves[0].cvss_v4}`
  : facts.cves.map((c) => `${c.id} CVSS v4.0 ${c.cvss_v4}`).join('、');
const platforms = [
  { href: '/dev/fix/debian/', label: 'Debian' },
  { href: '/dev/fix/ubuntu/', label: 'Ubuntu' },
  { href: '/dev/fix/rhel/', label: 'RHEL' },
  { href: '/dev/fix/alpine/', label: 'Alpine' },
  { href: '/dev/fix/windows/', label: 'Windows' },
  { href: '/dev/fix/macos/', label: 'macOS' },
  { href: '/dev/fix/docker/', label: 'Docker' },
  { href: '/dev/fix/panels/', label: '控制台' },
  { href: '/dev/fix/build-from-source/', label: '自行編譯' },
];
---
<CampaignLanding
  persona="dev"
  title="更新 PHP，重啟 worker，驗證版號。"
  description={`${ids}，${cvss}。更新到已修補版本、重啟 worker、再驗證版號。`}
  hero="dev-hub"
  heading="更新 PHP，重啟 worker，驗證版號。"
  actionsLabel="修補行動"
  actions={[
    { href: '/dev/checklist/', label: '立刻修補', primary: true },
    { href: '/dev/am-i-affected/', label: '我受影響嗎？' },
    { href: '/dev/mitigation/', label: '今天還不能升級' },
  ]}
>
  <p slot="sub" class="sub">
    <span class="sub__line">{ids}，{cvss}。</span>
    <span class="sub__line">修補於 <span class="num">{releaseClock.utc} UTC</span>／台灣 <span class="num">{releaseClock.taipeiShort}</span></span>
  </p>
  <ul slot="heroExtra" class="chips" aria-label="已修補版本（點選看版本矩陣）">
    {facts.fixed.map((item) => <li class="chip"><a class="chip-link" href="/dev/versions/">{item.version}</a></li>)}
  </ul>
  <nav slot="heroExtra" class="jump-line" aria-label="快速跳到">
    跳到：<a href="#step-versions">版本對照</a><span aria-hidden="true">｜</span><a href="#step-platform">選你的系統</a>
  </nav>
  <ol slot="body" class="steps">
    <li class="step">
      <h2 id="step-versions" class="step__title"><span class="step__no" aria-hidden="true">1</span>先看版本對照</h2>
      <ul class="fixed-list" aria-label="各分支要升級到的版本">
        {facts.fixed.map((f) => (
          <li><span class="num">{f.branch}</span> <span aria-hidden="true">→</span><span class="visually-hidden">：</span> 升級到 <strong class="num">{f.version}</strong> 以上</li>
        ))}
      </ul>
      <p class="fixed-note">升級後重啟所有 worker。</p>
      <details class="step__matrix">
        <summary>完整版本對照表</summary>
        <VersionMatrix />
      </details>
      <p class="step__more"><a href="/dev/versions/">完整版本矩陣與受影響 SAPI 風險排序 <span aria-hidden="true">→</span></a></p>
    </li>
    <li class="step">
      <h2 id="step-platform" class="step__title"><span class="step__no" aria-hidden="true">2</span>選你的系統</h2>
      <ul class="platforms" aria-labelledby="step-platform">
        {platforms.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <p class="step__more">不確定 PHP 從哪裡來？見<a href="/dev/am-i-affected/#source">先分辨 PHP 從哪裡來</a>。</p>
    </li>
  </ol>
  <p slot="strip" class="terms">看不懂 worker、SAPI、控制台？內文的專有名詞都有註解，也可以先翻<a href="/dev/glossary/">名詞表</a>。</p>
</CampaignLanding>

<style>
  .sub { container-type: inline-size; }
  .sub__line {
    display: block;
    /* 較長的那行（兩個 CVE 加 CVSS）在 17px 約 428px。窄欄用容器寬度把字縮到仍是一行；
       最小 13px，再窄就換行。 */
    font-size: clamp(0.8125rem, 3.55cqi, 1.0625rem);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 2px 10px;
    border: 2px solid var(--line-dev);
    border-radius: 999px;
    background: #fff;
    color: var(--on-line);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.5;
  }
  /* HeroBanner 把 hero 內的連結都改白字；版號在白底膠囊上，要壓回深字 */
  .chips .chip > a.chip-link:link,
  .chips .chip > a.chip-link:visited { color: var(--on-line); text-decoration: none; }
  .chips .chip > a.chip-link:hover,
  .chips .chip > a.chip-link:focus-visible { text-decoration: underline; }
  /* 小字外觀，連結觸控高度仍 ≥44px。顏色跟著 hero 文字走：窄螢幕是淺底深字，寬螢幕疊圖時 HeroBanner 改白字。 */
  .jump-line {
    margin: 12px 0 -6px;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .jump-line a {
    display: inline-block;
    padding: 12px 4px;
    margin: -12px 0;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .jump-line a:focus-visible {
    outline: 3px solid var(--line-dev);
    outline-offset: -3px;
  }

  .steps {
    display: grid;
    gap: 32px;
    max-width: 52rem;
    margin: 0 auto;
    padding: 32px var(--gutter) 8px;
    list-style: none;
  }
  /* 段落行寬約 30 個中文字；版本表與平台按鈕維持整欄寬 */
  .steps :global(p) { max-width: 60ch; }
  .step__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.5rem;
    font-weight: 900;
    scroll-margin-top: 16px;
  }
  .step__no {
    flex: none;
    display: grid;
    place-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--line-dev);
    color: var(--on-line);
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 1.25rem;
  }
  /* 預設只列每個分支要升到哪一版，讓手機上步驟 2 在一、兩個螢幕內出現；完整矩陣收在下方 details。 */
  .fixed-list {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .fixed-note {
    margin-top: 4px;
    font-size: 0.9375rem;
    color: var(--floor-ink-soft);
  }
  .step__matrix { margin-top: 6px; }
  .step__matrix > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }
  /* display:flex 會讓瀏覽器內建的三角形消失，自己補一個，展開時轉向 */
  .step__matrix > summary::-webkit-details-marker { display: none; }
  .step__matrix > summary::before {
    content: '▸';
    content: '▸' / '';
    flex: none;
    transition: transform 0.15s;
  }
  .step__matrix[open] > summary::before { transform: rotate(90deg); }
  @media (prefers-reduced-motion: reduce) {
    .step__matrix > summary::before { transition: none; }
  }
  .step__more {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--floor-ink-soft);
  }
  .step__more a {
    display: inline-block;
    padding: 10px 0;
    font-weight: 800;
    color: var(--floor-ink);
  }
  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }
  .platforms a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 8px 18px;
    border: 2px solid var(--line-dev);
    border-radius: 12px;
    background: #fff;
    color: var(--on-line);
    font-size: 1.0625rem;
    font-weight: 800;
    text-decoration: none;
  }
  .platforms a:hover { background: var(--line-dev); }
  .platforms a:hover,
  .platforms a:focus-visible { text-decoration: underline; text-underline-offset: 0.14em; }
  .platforms a:focus-visible,
  .step__more a:focus-visible,
  .step__matrix > summary:focus-visible,
  .terms a:focus-visible {
    outline: 3px solid var(--graphite);
    outline-offset: 3px;
  }

  .terms {
    max-width: calc(60ch + 2 * var(--gutter));
    margin: 0 auto;
    padding: 16px var(--gutter) 36px;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--floor-ink-soft);
  }
  .terms a { font-weight: 800; color: var(--floor-ink); }
</style>
