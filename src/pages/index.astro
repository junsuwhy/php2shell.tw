---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import HeroBanner from '../components/HeroBanner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { facts, site } from '../lib/data';
import { personas } from '../data/personas';
import WhatHappened from '../components/news/WhatHappened.astro';

const releasedTaipei = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(facts.released_at));
---
<Base title={site.title} persona="gateway" description="PHP2Shell（CVE-2026-109618、CVE-2026-109619）事件說明：網站老闆、工程師各有入口，另附事件始末、懶人包與時間軸。">
  <HeroBanner id="home-concourse" variant="home">
    <div class="station__text">
      <h1 id="station-title">{facts.name} 事件</h1>
      <p class="station__direction">你是哪一種人？選一個入口</p>
      <p class="station__hint">兩個入口只是依身份分開說明，都在這個網站裡，不用換站。只想知道發生什麼事，往下捲。</p>
      <dl class="station__meta">
        <div><dt>漏洞編號</dt><dd class="num">{facts.cves.map((c) => c.id).join('　')}</dd></div>
        <div><dt>嚴重程度</dt><dd><span class="num">CVSS {facts.cves[0].cvss_v4}</span>（重大）</dd></div>
        <div><dt>本站更新</dt><dd class="num">{facts.updated_at}</dd></div>
      </dl>
    </div>
  </HeroBanner>

  <nav class="exits" aria-label="選擇身份">
    {personas.map((p) => (
      <a class="exit" href={p.href} data-line={p.id}>
        <span class="exit__badge num" aria-hidden="true">{p.exit}</span>
        <span class="exit__head">
          <span class="exit__name">{p.name}</span>
        </span>
        <span class="exit__gets">{p.gets}</span>
        <ImageSlot id={p.image} class="exit__art" />
        <Arrow class="exit__arrow" />
        <span class="visually-hidden">（出口 {p.exit}，{p.line}）</span>
      </a>
    ))}
  </nav>

  <section class="notice" aria-labelledby="notice-title">
    <h2 id="notice-title">重要：有用 PHP 的網站，請立即更新</h2>
    <ul class="notice__versions" aria-label="已修補版本">
      {facts.fixed.map((f) => (
        <li>
          <a href="/dev/versions/" aria-label={`${f.branch} 系列已修補版本 ${f.version}：看版本對照與怎麼升級`}>
            <span class="notice__branch num">{f.branch} 系列</span><span class="notice__version num">{f.version}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="notice__more">8.1 以前的版本官方已不再發布更新，請盡快升級。</p>
    <p class="notice__ticket">
      來源：<a href={facts.official_advisory} rel="noopener">PHP 官方安全公告</a>
      <span class="num">{releasedTaipei}</span>（台灣時間）發布
    </p>
  </section>

  <WhatHappened />
</Base>


<style>
  [data-line='basic'] { --c: var(--line-basic); }
  [data-line='dev'] { --c: var(--line-dev); }

  /* 站名牌（字在 HeroBanner 裡；沒圖時整塊仍是深色） */
  .station__text h1,
  h1 {
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
  .station__direction {
    margin-top: 12px;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 700;
    color: var(--on-graphite);
  }
  .station__hint { margin-top: 8px; max-width: 40rem; color: var(--on-graphite-soft); }
  .station__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--graphite-rule);
    font-size: 0.9375rem;
  }
  .station__meta div { display: flex; gap: 10px; }
  .station__meta dt { color: var(--on-graphite-soft); }
  .station__meta dd { margin: 0; font-weight: 700; }
  /* 出口：一整面連續的導引牌，兩格以分隔線相接 */
  .exits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--graphite);
  }
  .exit {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'badge head head'
      'gets gets gets'
      'art art art'
      '. . arrow';
    align-items: center;
    gap: 16px 18px;
    padding: 28px clamp(20px, 2.6vw, 36px) 32px;
    color: var(--on-graphite);
    text-decoration: none;
    border-top: 14px solid var(--c);
    isolation: isolate;
  }
  .exit + .exit { border-left: 2px solid var(--graphite-rule); }
  /* 唯一的動態：路線色從頂邊向下漫入，箭頭往前一步 */
  .exit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    opacity: 0.16;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 520ms var(--ease-out);
  }
  .exit:hover::before,
  .exit:focus-visible::before { clip-path: inset(0 0 0 0); }
  .exit:hover,
  .exit:focus-visible { --arrow-shift: 0 -6px; }
  .exit:focus-visible { outline-offset: -6px; }

  .exit__badge {
    grid-area: badge;
    width: clamp(56px, 5.4vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c);
    color: var(--on-line);
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    font-weight: 900;
  }
  .exit__head { grid-area: head; display: grid; }
  .exit__name { font-size: clamp(1.75rem, 2.9vw, 2.5rem); font-weight: 900; line-height: 1.15; }
  .exit__gets { grid-area: gets; font-size: 1.1875rem; font-weight: 700; line-height: 1.55; }
  .exit :global(.exit__art) {
    grid-area: art;
    width: 100%;
    max-width: none;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .exit :global(.exit__arrow) {
    grid-area: arrow;
    justify-self: end;
    align-self: end;
    font-size: 2.75rem;
    color: var(--c);
  }
  .exit[data-line='basic'] { --arrow-rotate: -45deg; }
  .exit[data-line='dev'] { --arrow-rotate: 45deg; }

  /* 立即更新公告 */
  .notice {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 40px;
    padding: clamp(24px, 3.5vw, 40px) var(--gutter);
    background: var(--alert);
    color: var(--on-alert);
  }
  .notice h2 { grid-column: 1 / -1; font-size: clamp(1.375rem, 2.6vw, 2rem); font-weight: 900; }
  .notice__versions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notice__versions a {
    display: grid;
    text-decoration: none;
    min-width: 132px;
    padding: 10px 16px 12px;
    background: var(--on-alert);
    color: var(--alert);
  }
  .notice__versions a:hover .notice__version,
  .notice__versions a:focus-visible .notice__version { text-decoration: underline; }
  .notice__versions a:focus-visible { outline-color: var(--on-alert); }
  .notice__more a { color: var(--on-alert); font-weight: 700; }
  .notice__branch { font-size: 0.8125rem; font-weight: 700; color: #7a1222; }
  .notice__version { font-size: 1.875rem; font-weight: 900; line-height: 1.1; }
  .notice__more { max-width: 62ch; color: var(--on-alert); }
  .notice__ticket {
    align-self: end;
    font-size: 0.875rem;
    color: var(--on-alert-soft);
    padding-left: 16px;
    border-left: 1px dashed rgb(255 255 255 / 0.6);
  }
  .notice__ticket a { color: var(--on-alert); font-weight: 700; }

  @media (max-width: 860px) {
    .exits { grid-template-columns: 1fr; }
    .exit + .exit { border-left: 0; border-top-width: 14px; }
    .exit {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'badge head head'
        'gets gets gets'
        'art art art'
        '. . arrow';
      padding: 22px var(--gutter) 24px;
    }
    .exit[data-line] { --arrow-rotate: 90deg; }
    .exit :global(.exit__arrow) { font-size: 2.25rem; }
    .notice { grid-template-columns: 1fr; }
    .notice__ticket { border-left: 0; padding-left: 0; border-top: 1px dashed rgb(255 255 255 / 0.6); padding-top: 12px; }
  }
</style>
