---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import HeroBanner from '../components/HeroBanner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { facts, site } from '../lib/data';
import { personas } from '../data/personas';

const releasedTaipei = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(facts.released_at));
---
<Base title={site.title} persona="gateway" description="PHP2Shell（CVE-2026-109618、CVE-2026-109619）事件，依你的身份說清楚：網站老闆、工程師、吃瓜群眾各有出口。">
  <HeroBanner id="home-concourse" variant="home">
    <div class="station__text">
      <h1 id="station-title">{facts.name} 事件</h1>
      <p class="station__direction">請依你的身份，選擇出口</p>
      <dl class="station__meta">
        <div><dt>漏洞編號</dt><dd class="num">{facts.cves.map((c) => c.id).join('　')}</dd></div>
        <div><dt>嚴重程度</dt><dd><span class="num">CVSS {facts.cves[0].cvss_v4}</span>（重大）</dd></div>
        <div><dt>本站更新</dt><dd class="num">{facts.updated_at}</dd></div>
      </dl>
    </div>
  </HeroBanner>

  <p class="last-ride" hidden data-last-ride>
    <span>上次搭乘</span>
    <a href="#" data-last-ride-link></a>
  </p>

  <nav class="exits" aria-label="選擇身份">
    {personas.map((p) => (
      <a class="exit" href={p.href} data-line={p.id}>
        <span class="exit__badge num" aria-hidden="true">{p.exit}</span>
        <span class="exit__head">
          <span class="exit__name">{p.name}</span>
        </span>
        <span class="exit__gets">{p.gets}</span>
        <ImageSlot id={p.image} class="exit__art" />
        <span class="exit__toward"><span class="exit__toward-label">往</span>{p.toward}</span>
        <Arrow class="exit__arrow" />
        <span class="visually-hidden">（出口 {p.exit}，{p.line}）</span>
      </a>
    ))}
  </nav>

  <section class="notice" aria-labelledby="notice-title">
    <h2 id="notice-title">旅客注意：有用 PHP 的網站，請立即更新</h2>
    <ul class="notice__versions" aria-label="已修補版本">
      {facts.fixed.map((f) => (
        <li><span class="notice__branch num">{f.branch} 系列</span><span class="notice__version num">{f.version}</span></li>
      ))}
    </ul>
    <p class="notice__more">
      8.1 以前的版本官方已不再發布更新，請盡快升級。不確定自己用哪一版？從上面你的出口進去查。
    </p>
    <p class="notice__ticket">
      來源：<a href={facts.official_advisory} rel="noopener">PHP 官方安全公告</a>
      <span class="num">{releasedTaipei}</span>（台灣時間）發布
    </p>
  </section>
</Base>

<script>
  const names: Record<string, { name: string; href: string; line: string }> = {
    basic: { name: '非技術人員', href: '/basic/', line: '黃線' },
    dev: { name: '軟體開發人員', href: '/dev/', line: '綠線' },
    news: { name: '吃瓜群眾', href: '/news/', line: '粉紅線' },
  };
  let last: string | null = null;
  try { last = localStorage.getItem('php2shell:persona'); } catch {}
  const target = last ? names[last] : undefined;
  const box = document.querySelector<HTMLElement>('[data-last-ride]');
  const link = document.querySelector<HTMLAnchorElement>('[data-last-ride-link]');
  if (target && box && link && last) {
    link.href = target.href;
    link.textContent = `${target.line}・${target.name}，繼續 →`;
    box.dataset.line = last;
    box.hidden = false;
  }
</script>

<style>
  [data-line='basic'] { --c: var(--line-basic); }
  [data-line='dev'] { --c: var(--line-dev); }
  [data-line='news'] { --c: var(--line-news); }

  /* 站名牌（字在 HeroBanner 裡；沒圖時整塊仍是深色） */
  .station__text h1,
  h1 {
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
  .station__direction {
    margin-top: 12px;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-weight: 700;
    color: var(--on-graphite);
  }
  .station__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--graphite-rule);
    font-size: 0.9375rem;
  }
  .station__meta div { display: flex; gap: 10px; }
  .station__meta dt { color: var(--on-graphite-soft); }
  .station__meta dd { margin: 0; font-weight: 700; }
  /* 回訪 */
  .last-ride {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 12px var(--gutter);
    background: var(--graphite-2);
    color: var(--on-graphite-soft);
    font-size: 0.9375rem;
    border-top: 6px solid var(--c, var(--graphite-rule));
  }
  .last-ride[hidden] { display: none; }
  .last-ride a { color: var(--on-graphite); font-weight: 800; }

  /* 出口：一整面連續的導引牌，三格以分隔線相接 */
  .exits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    background: var(--graphite);
  }
  .exit {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'badge head head'
      'gets gets gets'
      'art art art'
      'toward toward arrow';
    align-items: center;
    gap: 16px 18px;
    padding: 28px clamp(20px, 2.6vw, 36px) 32px;
    color: var(--on-graphite);
    text-decoration: none;
    border-top: 14px solid var(--c);
    isolation: isolate;
  }
  .exit + .exit { border-left: 2px solid var(--graphite-rule); }
  /* 唯一的動態：路線色從頂邊向下漫入，箭頭往前一步 */
  .exit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    opacity: 0.16;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 520ms var(--ease-out);
  }
  .exit:hover::before,
  .exit:focus-visible::before { clip-path: inset(0 0 0 0); }
  .exit:hover,
  .exit:focus-visible { --arrow-shift: 0 -6px; }
  .exit:focus-visible { outline-offset: -6px; }

  .exit__badge {
    grid-area: badge;
    width: clamp(56px, 5.4vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c);
    color: var(--on-line);
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    font-weight: 900;
  }
  .exit__head { grid-area: head; display: grid; }
  .exit__name { font-size: clamp(1.75rem, 2.9vw, 2.5rem); font-weight: 900; line-height: 1.15; }
  .exit__gets { grid-area: gets; font-size: 1.1875rem; font-weight: 700; line-height: 1.55; }
  .exit :global(.exit__art) { grid-area: art; max-width: 220px; justify-self: start; border-radius: 4px; }
  .exit__toward {
    grid-area: toward;
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding-top: 14px;
    border-top: 1px solid var(--graphite-rule);
    font-size: 0.9375rem;
    color: var(--on-graphite-soft);
  }
  .exit__toward-label { font-weight: 900; color: var(--c); font-size: 1.0625rem; }
  .exit :global(.exit__arrow) {
    grid-area: arrow;
    justify-self: end;
    align-self: end;
    font-size: 2.75rem;
    color: var(--c);
  }
  .exit[data-line='basic'] { --arrow-rotate: -45deg; }
  .exit[data-line='dev'] { --arrow-rotate: 0deg; }
  .exit[data-line='news'] { --arrow-rotate: 45deg; }

  /* 旅客注意 */
  .notice {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 40px;
    padding: clamp(24px, 3.5vw, 40px) var(--gutter);
    background: var(--alert);
    color: var(--on-alert);
  }
  .notice h2 { grid-column: 1 / -1; font-size: clamp(1.375rem, 2.6vw, 2rem); font-weight: 900; }
  .notice__versions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notice__versions li {
    display: grid;
    min-width: 132px;
    padding: 10px 16px 12px;
    background: var(--on-alert);
    color: var(--alert);
  }
  .notice__branch { font-size: 0.8125rem; font-weight: 700; color: #7a1222; }
  .notice__version { font-size: 1.875rem; font-weight: 900; line-height: 1.1; }
  .notice__more { max-width: 62ch; color: var(--on-alert); }
  .notice__ticket {
    align-self: end;
    font-size: 0.875rem;
    color: var(--on-alert-soft);
    padding-left: 16px;
    border-left: 1px dashed rgb(255 255 255 / 0.6);
  }
  .notice__ticket a { color: var(--on-alert); font-weight: 700; }

  @media (max-width: 860px) {
    .exits { grid-template-columns: 1fr; }
    .exit + .exit { border-left: 0; border-top-width: 14px; }
    .exit {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'badge head art'
        'gets gets gets'
        'toward toward arrow';
      padding: 22px var(--gutter) 24px;
    }
    .exit :global(.exit__art) { width: 88px; max-width: none; justify-self: end; }
    .exit[data-line] { --arrow-rotate: 90deg; }
    .exit :global(.exit__arrow) { font-size: 2.25rem; }
    .notice { grid-template-columns: 1fr; }
    .notice__ticket { border-left: 0; padding-left: 0; border-top: 1px dashed rgb(255 255 255 / 0.6); padding-top: 12px; }
  }
</style>
