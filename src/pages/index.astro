---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import HeroBanner from '../components/HeroBanner.astro';
import ImageSlot from '../components/ImageSlot.astro';
import { facts, site } from '../lib/data';
import { personas } from '../data/personas';
import WhatHappened from '../components/news/WhatHappened.astro';

const releasedTaipei = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
}).format(new Date(facts.released_at));
---
<Base
  title={`${facts.name} 漏洞懶人包：該怎麼更新、怎麼檢查｜${site.title}`}
  persona="gateway"
  description={`${facts.name} 漏洞一次看懂：網站老闆可以確認網站有沒有事、該找誰處理，工程師可以直接查各平台的修補、緩解與偵測步驟，另附事件始末與時間軸。`}
>
  <HeroBanner id="home-concourse" variant="home">
    <div class="station__text">
      <h1 id="station-title">{facts.name} 事件</h1>
      <dl class="station__meta">
        <div><dt>漏洞編號</dt><dd class="num">{facts.cves.map((c) => c.id).join('　')}</dd></div>
        <div><dt>嚴重程度</dt><dd><span class="num">CVSS {facts.cves[0].cvss_v4}</span>（重大）</dd></div>
        <div><dt>本站更新</dt><dd class="num">{facts.updated_at}</dd></div>
      </dl>
    </div>
  </HeroBanner>

  <section class="notice" aria-labelledby="notice-title">
    <h2 id="notice-title">重要：有用 PHP 的網站，請立即更新</h2>
    <ul class="notice__versions" aria-label="已修補版本">
      {facts.fixed.map((f) => (
        <li>
          <a href="/dev/versions/" aria-label={`${f.branch} 系列已修補版本 ${f.version}：看版本對照與怎麼升級`}>
            <span class="notice__branch num">{f.branch} 系列</span><span class="notice__version num">{f.version}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="notice__cta">
      <a href="/basic/act/">我有網站，現在該做什麼<Arrow class="notice__cta-arrow" /></a>
    </p>
    <p class="notice__more">8.1 以前的版本官方已不再發布更新，請盡快升級。</p>
    <p class="notice__ticket">
      來源：<a href={facts.official_advisory} rel="noopener">PHP 官方安全公告</a>
      <span class="num">{releasedTaipei}</span>（台灣時間）發布
    </p>
  </section>

  <nav class="exits" aria-label="選擇身份">
    {personas.map((p) => (
      <a class="exit" href={p.href} data-line={p.id}>
        <span class="exit__badge num" aria-hidden="true">{p.exit}</span>
        <span class="exit__head">
          <span class="exit__name">{p.name}</span>
        </span>
        <span class="exit__gets">{p.gets}</span>
        <ImageSlot id={p.image} class="exit__art" />
        <Arrow class="exit__arrow" />
        <span class="visually-hidden">（出口 {p.exit}，{p.line}）</span>
      </a>
    ))}
  </nav>

  <WhatHappened />
</Base>


<style>
  [data-line='basic'] { --c: var(--line-basic); }
  [data-line='dev'] { --c: var(--line-dev); }

  /* 站名牌（字在 HeroBanner 裡；沒圖時整塊仍是深色）。例外：品牌主視覺大標，不套用全站字級。 */
  .station__text h1,
  h1 {
    font-size: clamp(2.5rem, 6.4vw, 5.25rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    line-height: 1.05;
  }
  .station__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 28px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--graphite-rule);
    font-size: var(--fs-small);
  }
  .station__meta div { display: flex; gap: 10px; }
  .station__meta dt { color: var(--on-graphite-soft); }
  .station__meta dd { margin: 0; font-weight: 700; }
  /* 出口：一整面連續的導引牌，兩格以分隔線相接 */
  .exits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    background: var(--graphite);
  }
  .exit {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      'badge head head'
      'gets gets gets'
      'art art art'
      '. . arrow';
    align-items: center;
    gap: 16px 18px;
    padding: 28px clamp(20px, 2.6vw, 36px) 32px;
    color: var(--on-graphite);
    text-decoration: none;
    border-top: 14px solid var(--c);
    isolation: isolate;
  }
  .exit + .exit { border-left: 2px solid var(--graphite-rule); }
  /* 唯一的動態：路線色從頂邊向下漫入，箭頭往前一步 */
  .exit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c);
    opacity: 0.16;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 520ms var(--ease-out);
  }
  .exit:hover::before,
  .exit:focus-visible::before { clip-path: inset(0 0 0 0); }
  .exit:hover,
  .exit:focus-visible { --arrow-shift: 0 -6px; }
  .exit:focus-visible { outline-offset: -6px; }

  .exit__badge {
    grid-area: badge;
    width: clamp(56px, 5.4vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c);
    color: var(--on-line);
    /* 例外：號碼牌字級與圓的直徑綁定，不套用全站字級 */
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    font-weight: 900;
  }
  .exit__head { grid-area: head; display: grid; }
  .exit__name { font-size: var(--fs-display); font-weight: 900; line-height: 1.15; }
  .exit__gets { grid-area: gets; font-size: var(--fs-lead); font-weight: 700; line-height: 1.55; }
  .exit :global(.exit__art) {
    grid-area: art;
    width: 100%;
    max-width: none;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 4px;
  }
  .exit :global(.exit__arrow) {
    grid-area: arrow;
    justify-self: end;
    align-self: end;
    /* 例外：SVG 箭頭圖示，以 1em 決定大小 */
    font-size: 2.75rem;
    color: var(--c);
  }
  .exit[data-line='basic'] { --arrow-rotate: -45deg; }
  .exit[data-line='dev'] { --arrow-rotate: 45deg; }

  /* 立即更新公告 */
  .notice {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 40px;
    padding: clamp(24px, 3.5vw, 40px) var(--gutter);
    background: var(--alert);
    color: var(--on-alert);
  }
  .notice h2 { grid-column: 1 / -1; font-size: var(--fs-heading); font-weight: 900; }
  .notice__versions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .notice__versions a {
    display: grid;
    text-decoration: none;
    min-width: 132px;
    padding: 10px 16px 12px;
    background: var(--on-alert);
    color: var(--alert);
  }
  .notice__versions a:hover .notice__version,
  .notice__versions a:focus-visible .notice__version { text-decoration: underline; }
  .notice__versions a:focus-visible { outline-color: var(--on-alert); }
  .notice__more a { color: var(--on-alert); font-weight: 700; }
  /* 主要行動：非技術訪客最常需要的下一步，用路線黃跟白色版本牌區隔 */
  .notice__cta { grid-column: 1 / -1; margin: 4px 0 0; }
  .notice__cta a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding: 12px 22px 12px 26px;
    border-radius: 999px;
    background: var(--line-basic);
    color: var(--on-line);
    box-shadow: 0 0 0 3px var(--on-line);
    font-size: var(--fs-lead);
    font-weight: 900;
    line-height: 1.3;
    text-decoration: none;
    --arrow-rotate: 90deg;
  }
  .notice__cta a:hover,
  .notice__cta a:focus-visible { --arrow-shift: 6px 0; text-decoration: underline; }
  .notice__cta a:focus-visible { outline: 3px solid var(--on-alert); outline-offset: 5px; }
  .notice__cta :global(.notice__cta-arrow) { flex: none; font-size: var(--fs-heading); }
  .notice__branch { font-size: var(--fs-small); font-weight: 700; color: #7a1222; }
  .notice__version { font-size: var(--fs-heading); font-weight: 900; line-height: 1.1; }
  .notice__more { max-width: 62ch; color: var(--on-alert); }
  .notice__ticket {
    align-self: end;
    font-size: var(--fs-small);
    color: var(--on-alert-soft);
    padding-left: 16px;
    border-left: 1px dashed rgb(255 255 255 / 0.6);
  }
  .notice__ticket a { color: var(--on-alert); font-weight: 700; }

  @media (max-width: 860px) {
    .exits { grid-template-columns: 1fr; }
    .exit + .exit { border-left: 0; border-top-width: 14px; }
    .exit {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'badge head head'
        'gets gets gets'
        'art art art'
        '. . arrow';
      padding: 22px var(--gutter) 24px;
    }
    .exit[data-line] { --arrow-rotate: 90deg; }
    .exit :global(.exit__arrow) { font-size: 2.25rem; }
    .notice { grid-template-columns: 1fr; }
    .notice__ticket { border-left: 0; padding-left: 0; border-top: 1px dashed rgb(255 255 255 / 0.6); padding-top: 12px; }
  }

  /* 手機第一屏：不捲動就要看到「請立即更新」、四個修補版本與主要按鈕 */
  @media (max-width: 600px) {
    .station__text h1,
    h1 { font-size: 2.25rem; }
    .station__meta {
      display: grid;
      gap: 2px;
      margin-top: 14px;
      padding-top: 10px;
    }
    .notice { gap: 12px; padding: 20px var(--gutter) 24px; }
    .notice h2 { line-height: 1.35; }
    .notice__versions {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .notice__versions a { min-width: 0; padding: 6px 8px 8px; }
    .notice__version { font-size: var(--fs-lead); }
    .notice__cta a { display: flex; width: 100%; min-height: 56px; padding: 10px 18px 10px 22px; }
    .notice__more,
    .notice__ticket { font-size: var(--fs-small); }

    /* 身份卡改成橫的一條：圖縮到右側小方塊 */
    .exit {
      grid-template-columns: auto minmax(0, 1fr) 84px;
      grid-template-rows: auto auto;
      grid-template-areas:
        'badge head art'
        'gets gets art';
      gap: 8px 14px;
      padding: 16px var(--gutter) 18px;
      border-top-width: 10px;
    }
    .exit + .exit { border-top-width: 10px; }
    .exit__badge { width: 44px; font-size: 1.5rem; }
    .exit__name { font-size: var(--fs-heading); }
    .exit__gets { font-size: var(--fs-body); padding-right: 0; }
    .exit :global(.exit__art) { width: 84px; aspect-ratio: 1; align-self: center; }
    /* 卡片已經矮成一條，整張都可點，裝飾用的箭頭先收起來 */
    .exit :global(.exit__arrow) { display: none; }
  }
</style>
