---
import CampaignLanding from '../../components/CampaignLanding.astro';
import { releaseTime as r } from '../../lib/data';
---
<CampaignLanding
  persona="basic"
  title="很多網站背後的 PHP 出了嚴重漏洞，修好的版本已經推出。"
  description="修好的版本已經推出。先看你現在該做什麼，或先了解發生什麼事、有多嚴重。"
  hero="basic-kitchen"
  heading="很多網站背後的 PHP 出了嚴重漏洞，修好的版本已經推出。"
  actionsLabel="你可以先做的事"
  actions={[
    { href: '/basic/act/', label: '我有網站，現在該做什麼', primary: true },
    { href: '/basic/what-happened/', label: '我想先了解發生什麼事、有多嚴重' },
  ]}
>
  <p slot="sub">
    台灣時間 <span class="num">{r.year}</span> 年 <span class="num">{r.month}</span> 月 <span class="num">{r.day}</span> 日<span class="keep">{r.taipei.part} <span class="num">{r.taipei.hour}</span> 點{r.taipei.minute > 0 && <> <span class="num">{r.taipei.minute}</span> 分</>}推出。</span>
  </p>
  <p slot="strip" class="mini">
    <a href="/basic/faq/">常見問題</a>
    <a href="/dev/">我是工程師 →</a>
  </p>
</CampaignLanding>

<style>
  .mini {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    max-width: 44rem;
    margin: 0 auto;
    padding: 22px var(--gutter) 40px;
    font-size: var(--fs-body);
  }
  .keep { white-space: nowrap; }
  .mini a { font-weight: 800; }
  .mini a:focus-visible {
    outline: 3px solid var(--line-basic);
    outline-offset: 4px;
  }
</style>
