---
// 非技術區的單一行動頁：三件事 → 兩個問題 → 各系統段落 → 怎樣算處理完。
// 原本獨立的檢查頁、「怎樣算處理完」頁與七個系統頁都併進這一頁，舊網址由 public/_redirects 轉到下面的錨點。
import BasicPage from '../../components/basic/BasicPage.astro';
import AskVendor from '../../components/basic/AskVendor.astro';
import SafeVersions from '../../components/basic/SafeVersions.astro';
import { facts } from '../../lib/data';

interface Choice { href: string; label: string; hint?: string }

const q1: Choice[] = [
  { href: '#q2', label: '主機商', hint: '每月或每年付主機費給一家公司，你或同事有它給的後台帳號' },
  { href: '#q2', label: '我們自己或公司的資訊人員', hint: '自己租整台主機或雲端主機，由自己人管理' },
  { href: '#vendor', label: '外包廠商或資訊公司', hint: '網站出問題時，你會打給某家公司處理' },
  { href: '#hosted', label: '開店平台', hint: '例如 Shopify 這類付月費就能開店的平台，主機由平台管' },
  { href: '#unknown', label: '我不知道', hint: '從找出負責人開始' },
];

const q2: Choice[] = [
  { href: '#wordpress', label: 'WordPress', hint: '左邊一排黑色選單，有「文章」「外掛」' },
  { href: '#drupal', label: 'Drupal', hint: '上方有「內容」「結構」「外觀」「報告」' },
  { href: '#joomla', label: 'Joomla', hint: '有「系統」「使用者」「選單」「元件」' },
  { href: '#shop', label: '網路商店系統', hint: 'WooCommerce、Magento 等，有商品和訂單管理' },
  { href: '#cpanel', label: 'cPanel 主機控制台', hint: '主機商給的後台，一格一格的圖示' },
  { href: '#plesk', label: 'Plesk 主機面板', hint: '主機商給的後台，左邊有「網站與網域」' },
  { href: '#unknown', label: '都沒有，或我不確定', hint: '帶你找出該問誰' },
];

const jump = [
  { href: '#q1', label: '找出處理方式' },
  { href: '#wordpress', label: 'WordPress' },
  { href: '#drupal', label: 'Drupal' },
  { href: '#joomla', label: 'Joomla' },
  { href: '#shop', label: '網路商店' },
  { href: '#cpanel', label: 'cPanel' },
  { href: '#plesk', label: 'Plesk' },
  { href: '#outsourced', label: '外包／不知道誰做的' },
  { href: '#done', label: '怎樣算處理完' },
  { href: '#reopen', label: '什麼時候能重新開' },
  { href: '#no-owner', label: '找不到人負責' },
];

const versions = facts.fixed.map((f) => f.version).join('、');
const memo = `主旨：網站受 PHP 重大漏洞影響，需要決定處理方式

PHP 官方在 2026-10-21 公布重大漏洞 PHP2Shell，外人可能不用帳號就能在網站主機上執行程式。美國、英國的資安單位建議，無法立刻更新的系統考慮先下線。

我們的網站：（網址）
目前狀況：找不到負責維護的廠商或人員，無法確認是否已更新。

建議：
1. 今天先讓網站暫停對外，直到確認已更新。
2. 指定負責人，聯絡主機商或另找廠商接手更新。
3. 更新後請廠商檢查有沒有被闖入的跡象，再決定何時重新開放。`;
---
<BasicPage
  title="你需要做的三件事"
  heading="你需要做的三件事"
  description="弄清楚誰在管網站、請對方更新背後的 PHP 並給版本號；還沒確認前，考慮先暫停網站。依你的後台找到該找誰、要傳的詢問訊息，以及怎樣算處理完。"
>
  <nav class="jump-line" aria-label="快速跳到">
    跳到：<a href="#q1">選你的系統</a><span aria-hidden="true">｜</span><a href="#done">怎樣算處理完</a>
  </nav>

  <ol class="step-cards">
    <li><strong>弄清楚你的網站是什麼、誰在管。</strong>是 WordPress？放在哪家主機？還是外包廠商做的？不知道也沒關係，下面會一步步帶你找。</li>
    <li><strong>請管主機的人更新「主廚」，並給你版本號。</strong>只按網站後台的「更新外掛」不夠，要更新的是背後的 PHP。對方要能說出更新後的版本號，口頭說「我們有資安防護」不算數；怎樣才算完成，見<a href="#done">怎樣算處理完</a>。網站前面的防火牆、幫網站擋流量的加速服務、主機商的防護規則，都只能多一層看守，不能代替把主廚換掉。<AskVendor to="主機商或廠商" level={3} idPrefix="step" /></li>
    <li><strong>還沒確認前，考慮先暫停網站。</strong>如果今天拿不到「已經更新」的答覆，先讓網站暫停對外比較安全。萬一懷疑被闖入，請廠商<strong>先把紀錄留下來，不要急著整台重灌</strong>。</li>
  </ol>

  <p class="go"><a href="#q1">找出你的處理方式 <span aria-hidden="true">→</span></a></p>

  <nav class="jump" aria-label="本頁段落">
    <ul>
      {jump.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
    </ul>
  </nav>

  <!-- ===== 找出你的處理方式（原檢查頁） ===== -->
  <section class="check" aria-labelledby="check-title">
    <h2 id="check-title">找出你的處理方式</h2>
    <p class="check__lead">這裡不會掃描或連線到你的網站，只是依你的情況，帶你到該看的那一段。回答兩個問題，選「不知道」也可以。</p>

    <div class="wizard" data-wizard>
      <section class="q" id="q1" aria-labelledby="q1-title" data-step>
        <p class="q__no">問題 <span class="num">1</span>／<span class="num">2</span></p>
        <h3 id="q1-title" tabindex="-1">誰有權限更新主機上的 PHP？</h3>
        <p>PHP 裝在放網站的主機上。這裡問的是誰管主機，不是誰更新文章。</p>
        <ul class="choices">
          {q1.map((c) => (
            <li>
              <a class="choice" href={c.href}>
                <span class="choice__label">{c.label}</span>
                {c.hint && <span class="choice__hint">{c.hint}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="q" id="q2" aria-labelledby="q2-title" data-step>
        <p class="q__no">問題 <span class="num">2</span>／<span class="num">2</span></p>
        <h3 id="q2-title" tabindex="-1">你能登入的後台是哪一種？</h3>
        <p>同時有好幾個很常見，例如 WordPress 加上 WooCommerce，再加上主機商的 cPanel。能登入 cPanel 或 Plesk 就選它，那裡離 PHP 最近；不然選你的網站後台。要做的事都一樣：請管主機的人更新 PHP。</p>
        <ul class="choices">
          {q2.map((c) => (
            <li>
              <a class="choice" href={c.href}>
                <span class="choice__label">{c.label}</span>
                {c.hint && <span class="choice__hint">{c.hint}</span>}
              </a>
            </li>
          ))}
        </ul>
        <p class="q__back"><a href="#q1">← 回到問題 1</a></p>
      </section>
    </div>
  </section>

  <!-- ===== 各系統（原七個系統頁） ===== -->
  <div class="systems">
    <!-- WordPress -->
    <details class="sys" id="wordpress">
      <summary>
        <h2 class="sys__title">我的網站是 WordPress</h2>
        <span class="sys__lead">先講最重要的一句：這次只按 WordPress 的「更新」不夠。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <div class="callout callout--warn">
          <p><strong>只更新 WordPress 本身、外掛、佈景主題，修不好這次的問題。</strong>WordPress 是食譜，這次要換的是廚房裡的主廚 PHP。WordPress 官方也說明，不會為這件事發布 WordPress 更新。</p>
        </div>

        <h3>在後台看 PHP 版本</h3>
        <p>你需要能登入 WordPress 後台，而且是「管理員」身分。</p>
        <ol class="steps">
          <li>登入 WordPress 後台。</li>
          <li>左邊選單點 <span class="path">工具</span>，再點 <span class="path">網站健康狀態</span>。</li>
          <li>上方切到 <span class="path">資訊</span> 分頁。</li>
          <li>展開 <span class="path">伺服器</span> 這一段，找「PHP 版本」那一列，把數字抄下來。</li>
        </ol>
        <p>選單是英文的話，依序是 <span class="path">Tools</span> → <span class="path">Site Health</span> → <span class="path">Info</span> → <span class="path">Server</span>。看不到「工具」選單，通常是帳號權限不夠，請找當初給你帳號的人，或直接看下面的「該找誰」。</p>

        <SafeVersions level={3} idPrefix="wordpress" />

        <h3>該找誰？</h3>
        <ul>
          <li><strong>網站放在虛擬主機（每月付費給主機商）：</strong>找主機商。主廚是他們在管，你多半沒辦法自己換。</li>
          <li><strong>網站是外包廠商做的、也是他們在維護：</strong>找外包廠商。</li>
          <li><strong>公司有自己的資訊人員：</strong>把這頁和<a href="/dev/am-i-affected/#cms">給工程師的檢查說明</a>轉給他。</li>
        </ul>
        <AskVendor level={3} inline={false} idPrefix="wordpress" />

        <h3>還沒拿到答覆前</h3>
        <p>WordPress 的「維護模式」外掛擋不住這次的問題，因為事情發生在 WordPress 開始動作之前。如果今天拿不到「已經更新」的答覆，請主機商或廠商<strong>直接讓網站暫停對外</strong>，比較安全。</p>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- Drupal -->
    <details class="sys" id="drupal">
      <summary>
        <h2 class="sys__title">我的網站是 Drupal</h2>
        <span class="sys__lead">從後台的「狀態報告」就能看到版本，再對照下面的表格。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <div class="callout">
          <p>Drupal 是食譜，PHP 是廚房裡的主廚。這次要換的是主廚，所以<strong>只更新 Drupal 或它的模組，修不好這次的問題</strong>。</p>
        </div>

        <h3>在後台看 PHP 版本</h3>
        <p>你需要能登入 Drupal 後台，並且有管理權限。</p>
        <ol class="steps">
          <li>登入 Drupal 後台。</li>
          <li>上方管理選單點 <span class="path">報告</span>。</li>
          <li>點 <span class="path">狀態報告</span>。</li>
          <li>在清單裡找「PHP」那一列，把版本號抄下來。</li>
        </ol>
        <p>選單是英文的話，依序是 <span class="path">Reports</span> → <span class="path">Status report</span>。看不到「報告」選單，代表帳號權限不夠，請找當初給你帳號的人。</p>

        <SafeVersions level={3} idPrefix="drupal" />

        <h3>該找誰？</h3>
        <ul>
          <li><strong>網站放在虛擬主機或代管平台：</strong>找主機商或平台客服，請他們更新主廚。</li>
          <li><strong>網站是外包廠商做的：</strong>找外包廠商，請他們確認主機也一起更新了。</li>
          <li><strong>機關或公司有自己的資訊人員：</strong>把這頁和<a href="/dev/am-i-affected/#cms">給工程師的檢查說明</a>轉給他。</li>
        </ul>
        <AskVendor level={3} inline={false} idPrefix="drupal" />

        <h3>還沒拿到答覆前</h3>
        <p>Drupal 自己的「維護模式」擋不住這次的問題，因為事情發生在 Drupal 開始動作之前。拿不到答覆的話，請主機商或廠商讓網站暫停對外。</p>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- Joomla -->
    <details class="sys" id="joomla">
      <summary>
        <h2 class="sys__title">我的網站是 Joomla</h2>
        <span class="sys__lead">從後台的「系統資訊」就能看到版本，再對照下面的表格。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <div class="callout">
          <p>Joomla 是食譜，PHP 是廚房裡的主廚。這次要換的是主廚，所以<strong>只更新 Joomla 或它的擴充套件，修不好這次的問題</strong>。</p>
        </div>

        <h3>在後台看 PHP 版本</h3>
        <p>你需要能登入 Joomla 管理後台，並且有管理權限。</p>
        <ol class="steps">
          <li>登入 Joomla 管理後台。</li>
          <li>左邊選單點 <span class="path">系統</span>。</li>
          <li>在「資訊」區塊點 <span class="path">系統資訊</span>。</li>
          <li>在「系統資訊」分頁找「PHP 版本」那一列，把數字抄下來。</li>
        </ol>
        <p>選單是英文的話，依序是 <span class="path">System</span> → <span class="path">System Information</span>。不同版本的 Joomla 選單位置可能略有不同，找「系統資訊」這幾個字就對了。</p>

        <SafeVersions level={3} idPrefix="joomla" />

        <h3>該找誰？</h3>
        <ul>
          <li><strong>網站放在虛擬主機：</strong>找主機商，請他們更新主廚。</li>
          <li><strong>網站是外包廠商做的：</strong>找外包廠商，請他們確認主機也一起更新了。</li>
          <li><strong>有自己的資訊人員：</strong>把這頁和<a href="/dev/am-i-affected/#cms">給工程師的檢查說明</a>轉給他。</li>
        </ul>
        <AskVendor level={3} inline={false} idPrefix="joomla" />

        <h3>還沒拿到答覆前</h3>
        <p>Joomla 後台的「網站離線」設定擋不住這次的問題，因為事情發生在 Joomla 開始動作之前。拿不到答覆的話，請主機商或廠商讓網站暫停對外。</p>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- 網路商店 -->
    <details class="sys" id="shop">
      <summary>
        <h2 class="sys__title">我開的是網路商店</h2>
        <span class="sys__lead">先分清楚：你的商店是「自己租店面」，還是「進駐百貨公司專櫃」？</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <section id="hosted" class="part">
          <h3>進駐百貨公司專櫃：Shopify 這類開店平台</h3>
          <p>如果你是付月費給 Shopify 這類開店平台，用它的後台上架商品，那麼廚房、主廚、整棟大樓都是平台在管。<strong>主機要不要更新、怎麼更新，由平台處理</strong>，你沒辦法、也不需要自己動手。</p>
          <p>你也不用自己判斷「我算不算有用 PHP」。首頁那句「有用 PHP 的網站，請立即更新」，在你的情況是平台的工作。</p>
          <ul>
            <li>留意平台寄來的 Email 或後台公告。</li>
            <li>平台沒有公告被入侵，就不用因為新聞而慌張改設定。</li>
            <li>有人私訊說要「幫你檢查商店有沒有中毒」並收費，當成詐騙處理。</li>
          </ul>
        </section>

        <section class="part">
          <h3>自己租店面：WooCommerce、Magento 這類</h3>
          <p>如果你的商店是用 <strong>WooCommerce</strong>（裝在 WordPress 上的購物車）、<strong>Magento</strong>，或其他需要自己租主機的商店系統，那麼廚房是你（或你的主機商、外包廠商）在管。這次被點名的系統裡，Magento 和 WordPress 都在名單上。</p>
          <div class="callout callout--warn">
            <p><strong>只更新商店系統或外掛，修不好這次的問題。</strong>要更新的是背後的主廚 PHP。商店裡有顧客資料和訂單，更要優先處理。</p>
          </div>
          <h4>怎麼看版本</h4>
          <ul>
            <li><strong>WooCommerce：</strong>它住在 WordPress 裡，照 <a href="#wordpress">WordPress 段落</a>的「網站健康狀態」步驟看。</li>
            <li><strong>Magento 或其他商店系統：</strong>後台通常不好找，直接請主機商或做網站的廠商回覆版本號最快。</li>
          </ul>
        </section>

        <SafeVersions level={3} idPrefix="shop" />

        <h3>該找誰？</h3>
        <ul>
          <li><strong>主機是你租的：</strong>找主機商。</li>
          <li><strong>商店是外包廠商架的：</strong>找外包廠商，請他們確認主機也一起更新了。</li>
          <li><strong>不確定是哪一種：</strong>看<a href="#unknown">不知道網站是誰做的</a>那一段。</li>
        </ul>
        <AskVendor level={3} inline={false} idPrefix="shop" />
        <p>拿不到「已經更新」的答覆前，請考慮讓商店暫停對外。商店後台的「維護模式」擋不住這次的問題，要請主機商從外面直接暫停。</p>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- cPanel -->
    <details class="sys" id="cpanel">
      <summary>
        <h2 class="sys__title">我用 cPanel 虛擬主機</h2>
        <span class="sys__lead">你可以在 cPanel 看到網站用哪一個系列的 PHP，但「把主廚換新」這件事，多半要主機商來做。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <div class="callout">
          <p>把主機想成一棟美食街大樓：cPanel 是你那一攤的管理面板，主廚則由大樓（主機商）統一派駐。<strong>換新主廚，要大樓來做</strong>；你在面板上能做的，主要是「選要哪一個系列的主廚」。</p>
        </div>

        <h3>在哪裡看 PHP 版本</h3>
        <ol class="steps">
          <li>登入主機商給你的 cPanel。</li>
          <li>在首頁找 <span class="path">軟體</span> 區塊。</li>
          <li>點 <span class="path">MultiPHP 管理員</span>（英文是 MultiPHP Manager）。有些主機商叫做 <span class="path">選擇 PHP 版本</span>（Select PHP Version）。</li>
          <li>畫面會列出你的網域，以及每個網域用的 PHP 系列，例如「PHP 8.3」。</li>
        </ol>
        <p>找不到這些項目，代表主機商把這個功能關掉或換了名字。這時直接問主機商就好。</p>

        <h3>可以自己切換嗎？切換有用嗎？</h3>
        <p>在同一個畫面，可以替網域選另一個系列的 PHP。但要注意兩件事：</p>
        <ul>
          <li><strong>切換「系列」不等於「修補」。</strong>cPanel 通常只顯示「8.3」這種前兩段，看不出最後一段的修補號碼。8.3 系列有沒有換成修好的版本，是主機商那邊的事。</li>
          <li><strong>從很舊的系列（例如 7 開頭）直接切到新的，網站可能打不開。</strong>請先問做網站的人或主機商，再動手。</li>
        </ul>

        <SafeVersions level={3} idPrefix="cpanel" />

        <h3>什麼時候一定要找主機商？</h3>
        <ul>
          <li><strong>任何時候都要問一次：</strong>「這台主機的 PHP 已經更新到修補版，並且重新啟動了嗎？」只有主機商能回答。</li>
          <li>你看到的系列是 <span class="num">8.1</span>、<span class="num">8.0</span>、<span class="num">7.4</span> 或更舊。</li>
          <li>你找不到可以看版本的地方，或看不懂畫面。</li>
          <li>主機商的公告裡沒有提到這次的事件。</li>
        </ul>
        <AskVendor to="主機商" level={3} inline={false} idPrefix="cpanel" />
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- Plesk -->
    <details class="sys" id="plesk">
      <summary>
        <h2 class="sys__title">我用 Plesk 主機面板</h2>
        <span class="sys__lead">Plesk 官方的建議很簡單：把 Plesk 更新到最新。這件事通常由主機商或管主機的人來做。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <div class="callout">
          <p>Plesk 像是整棟餐廳大樓的管理處，主廚由管理處派駐。Plesk 已經準備好修好的主廚，<strong>只要管理處把 Plesk 更新到最新，就會換上</strong>。</p>
        </div>

        <h3>在哪裡看 PHP 版本</h3>
        <ol class="steps">
          <li>登入 Plesk。</li>
          <li>左邊點 <span class="path">網站與網域</span>（英文是 Websites &amp; Domains）。</li>
          <li>找到你的網域，點 <span class="path">PHP</span> 或 <span class="path">PHP 設定</span>。</li>
          <li>畫面上方會寫目前用的 PHP 版本。</li>
        </ol>
        <p>不同主機商的 Plesk 畫面可能略有不同。找不到的話，直接問主機商。</p>

        <SafeVersions level={3} idPrefix="plesk" />
        <p>補充：Plesk 有些舊系列（例如 <span class="num">8.1</span>、<span class="num">8.0</span>、<span class="num">7.4</span>）修好之後<strong>版號看起來沒變</strong>，只能從更新日期分辨。所以看到這些系列，更要請主機商用文字確認。</p>

        <h3>該找誰？</h3>
        <ul>
          <li><strong>你是租用主機的客戶（主機商給你 Plesk 帳號）：</strong>找主機商，請他們確認 Plesk 已更新到最新，並回覆完整版本號。</li>
          <li><strong>你們自己有一台主機、由資訊人員或外包廠商管理：</strong>請他們今天就把 Plesk 更新到最新，並把<a href="/dev/fix/panels/">給工程師的控制台頁</a>轉給他們。</li>
        </ul>
        <AskVendor level={3} inline={false} idPrefix="plesk" />
        <p>拿不到明確答覆前，請考慮先讓網站暫停對外。</p>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>

    <!-- 外包或不知道誰做的 -->
    <details class="sys" id="outsourced">
      <summary>
        <h2 class="sys__title">網站是外包的，或我不知道是誰做的</h2>
        <span class="sys__lead">找到對的人，並拿到一句白紙黑字的回覆。</span>
        <span class="sys__icon" aria-hidden="true"></span>
      </summary>
      <div class="sys__body">
        <section class="part" id="vendor">
          <h3>網站是外包廠商做的、也由他們維護</h3>
          <p>最簡單的情況。外包廠商就像幫你經營餐廳的管理公司，換主廚是他們的工作。把下面的訊息傳給他們。</p>
          <AskVendor to="外包廠商" level={4} inline={false} idPrefix="outsourced" />
          <div class="callout">
            <p>廠商說「網站程式我們更新過了」還不夠。請確認他們連<strong>主機上的 PHP</strong> 也一起更新了；如果主機是另一家公司租的，廠商要去問那家公司，或請你去問。</p>
          </div>
        </section>

        <section class="part" id="unknown">
          <h3>我不知道網站是誰做的</h3>
          <p>很常見，尤其是幾年前做的網站、或承辦人換過的單位。照下面的順序找，通常找得到：</p>
          <ol class="steps">
            <li><strong>翻帳單和合約。</strong>每月或每年付給哪家公司「主機費」「網站維護費」？那家公司就是第一個要問的對象。</li>
            <li><strong>找網址的續約通知。</strong>網址（例如 .com.tw）每年要續約，續約信或發票上的公司，通常知道網站放在哪裡。</li>
            <li><strong>看網站最下面。</strong>很多網站頁尾會寫「網站設計：某某公司」。</li>
            <li><strong>問前任承辦人或會計。</strong>付款紀錄會留下廠商名字。</li>
          </ol>
          <p>找到任何一家相關的公司，就先把訊息傳給它，請它告訴你網站實際由誰管理。網站有沒有用 PHP、要不要更新，交給對方判斷就好，你不用先弄懂。</p>
          <div class="callout callout--warn">
            <p><strong>真的找不到人管？</strong>沒有人照顧的網站最危險。請考慮先把網站暫停對外，再慢慢找人接手；誰能幫你關、怎麼跟主管說，見<a href="#no-owner">找不到人負責時</a>。舊的活動網站、測試網站也一樣，只要還打得開，就算在內。</p>
          </div>
        </section>

        <section class="part">
          <h3>機關、學校與公司的主管</h3>
          <p>指定一位同事負責回答一個問題：「我們有哪些網站和系統用到 PHP？」連同官網、舊的活動網站、報名系統，以及廠商設備裡附帶的管理網頁。數位發展部資通安全署已經發布通知，請各單位盤點、更新，並檢查紀錄。</p>
        </section>
        <p class="sys__done"><a href="#done">拿到回覆後，對照怎樣算處理完 <span aria-hidden="true">→</span></a></p>
      </div>
    </details>
  </div>

  <!-- ===== 怎樣算處理完（原處理完頁） ===== -->
  <section class="finish" aria-labelledby="finish-title">
    <h2 id="finish-title">怎樣算處理完？什麼時候能重新開站？</h2>
    <p class="finish__lead">拿到對方的文字回覆後，用這一段逐項對照。</p>

    <section class="part" id="done">
      <h3>處理完的條件</h3>
      <p>下面四項<strong>都符合</strong>，才算處理完：</p>
      <ol class="steps">
        <li>
          <strong>版本已修補</strong>，符合其中一種：
          <ul>
            <li>版本號達到安全版本（<span class="num">{versions}</span> 或更新，見下面的表格）。</li>
            <li>版本號看起來比較舊，但對方附上作業系統或主機商的<strong>安全公告編號</strong>，說明這個版本已經含修補。這是廠商把修補裝進舊版本，常見於主機商。</li>
          </ul>
        </li>
        <li><strong>已經重新啟動</strong>。沒有重新啟動，舊的程式還在跑，等於沒換。</li>
        <li><strong>每個網站都問過</strong>。官網、舊的活動網站、報名系統、測試網站，只要還打得開就算。</li>
        <li><strong>檢查過異常</strong>。對方看過存取紀錄和網站檔案，回覆「沒有發現異常」，或說明發現了什麼。</li>
      </ol>
      <p>只回「我們有防護」「已經處理」而沒有版本號，不算。</p>
      <SafeVersions level={4} idPrefix="done" />
    </section>

    <section class="part" id="reopen">
      <h3>暫停的網站，什麼時候能重新開？</h3>
      <h4>沒有發現異常：只是預防性暫停</h4>
      <p>上面四項都符合，就可以重新開放。</p>

      <h4>發現異常，或懷疑被闖入</h4>
      <p>更新只是把門鎖換掉，不會把已經進來的人請出去。這時<strong>不要一更新完就開站</strong>，請廠商或資安公司做完下面這些再開：</p>
      <ol class="steps">
        <li><strong>先保留紀錄</strong>，不要急著整台重灌。重灌會把線索清掉。</li>
        <li><strong>查清楚有沒有被放了東西、被拿走什麼</strong>，並清除；必要時從被闖入之前的備份重建。</li>
        <li><strong>換掉網站用到的密碼和鑰匙</strong>：網站後台、資料庫、主機帳號，以及網站拿來串接其他服務的金鑰。這次的漏洞可能讓外人讀到主機記憶體裡的這些資料。</li>
        <li>網站有會員或客戶個人資料的話，<strong>評估是否要依法通報</strong>。機關學校請找單位的資安窗口。</li>
      </ol>
    </section>

    <section class="part" id="no-owner">
      <h3>找不到人負責，誰能幫我關站？</h3>
      <p>先照<a href="#unknown">找出負責人</a>的步驟找。真的找不到時：</p>
      <ul>
        <li><strong>知道主機是哪家（有付主機費）：</strong>以付款帳號的身分聯絡主機商客服，請他們暫停這個網站，或直接幫忙更新 PHP。帳號是你們的，主機商可以做。</li>
        <li><strong>連主機商都查不到：</strong>找網址每年續約的那家公司（網址註冊商）。登入網址的管理帳號，或請他們協助，暫時讓網址不要連到這個網站，訪客就打不開了。</li>
        <li><strong>機關、學校、公司：</strong>這已經超出你一個人能決定的範圍，請交給主管，並通知單位的資安窗口。下面這段可以直接轉給主管。</li>
      </ul>
      <figure class="memo">
        <figcaption>給主管的說明</figcaption>
        <pre>{memo}</pre>
      </figure>
    </section>
  </section>

  <p class="aside">要把技術細節交給你的工程師？請他看<a href="/dev/">給工程師的這一區</a>。</p>
</BasicPage>

<script>
  // 頁內錨點：目標在收合段落裡時，先打開所有外層 <details>，再捲動、聚焦。
  // 兩個問題一次只顯示一題。沒有 JavaScript 時兩題都顯示，靠原生 <details> 與錨點跳轉。
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('[data-wizard] [data-step]'));

  const showStep = (id: string) => {
    if (!steps.length) return;
    const target = steps.find((s) => s.id === id) ?? steps[0];
    steps.forEach((s) => { s.hidden = s !== target; });
  };

  const targetOf = (hash: string) => {
    if (hash.length < 2) return null;
    try {
      return document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return null;
    }
  };

  const reveal = (hash: string, focus: boolean, smooth: boolean) => {
    const el = targetOf(hash);
    if (!el) return;
    const step = el.closest<HTMLElement>('[data-step]');
    if (step) showStep(step.id);
    for (let d = el.closest('details'); d; d = d.parentElement?.closest('details') ?? null) d.open = true;
    el.scrollIntoView({ behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto', block: 'start' });
    if (!focus) return;
    // <details> 聚焦到 summary；其他段落聚焦到它的標題
    const to =
      el instanceof HTMLDetailsElement
        ? el.querySelector<HTMLElement>(':scope > summary')
        : el.matches('h2, h3, h4')
          ? el
          : el.querySelector<HTMLElement>('h2, h3, h4') ?? el;
    if (!to) return;
    if (!to.matches('a, button, summary, [tabindex]')) to.setAttribute('tabindex', '-1');
    to.focus({ preventScroll: true });
  };

  showStep(location.hash.slice(1));
  reveal(location.hash, false, false);

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link) return;
    const url = new URL(link.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || !targetOf(url.hash)) return;
    event.preventDefault();
    if (url.hash !== location.hash) history.pushState(null, '', url.hash);
    reveal(url.hash, true, true);
  });

  // 上一頁／下一頁或手動改網址的錨點
  window.addEventListener('hashchange', () => {
    if (!targetOf(location.hash)) showStep('');
    reveal(location.hash, true, true);
  });
</script>

