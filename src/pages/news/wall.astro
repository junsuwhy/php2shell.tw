---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import { countBy, getNews, languageLabel, sourceGroup, sourceGroups } from '../../lib/news';

const news = await getNews();
const languages = countBy(news.map((n) => n.data.language));
const groups = sourceGroups
  .map((g) => [g, news.filter((n) => sourceGroup(n.data.source_type) === g).length] as const)
  .filter(([, c]) => c > 0);
const tags = countBy(news.flatMap((n) => n.data.tags));
---
<Base title="新聞牆" persona="news" description="PHP2Shell 事件的新聞、官方公告與研究報告摘要，可依語言、來源類型與標籤篩選。">
  <article class="page">
    <header class="page__head">
      <p class="kicker"><a href="/news/">吃瓜懶人包</a></p>
      <h1>新聞牆</h1>
      <p>本站讀過、整理成摘要的 <span class="num">{news.length}</span> 則新聞、官方公告與研究報告，由新到舊。時間是台灣時間；原文只標日期的就只寫日期。點標題看本站摘要，摘要頁有原文連結。</p>
    </header>

    <form class="filters" data-filters hidden aria-label="篩選新聞">
      <label>
        語言
        <select name="lang">
          <option value="">全部</option>
          {languages.map(([v, c]) => <option value={v}>{languageLabel(v)}（{c}）</option>)}
        </select>
      </label>
      <label>
        來源類型
        <select name="group">
          <option value="">全部</option>
          {groups.map(([v, c]) => <option value={v}>{v}（{c}）</option>)}
        </select>
      </label>
      <label>
        標籤
        <select name="tag">
          <option value="">全部</option>
          {tags.map(([v, c]) => <option value={v}>{v}（{c}）</option>)}
        </select>
      </label>
      <button type="reset">清除篩選</button>
      <p class="filters__count" role="status" aria-live="polite" data-count></p>
    </form>

    <div class="wall" data-wall>
      {news.map((entry) => <NewsCard entry={entry} headingLevel="h2" />)}
    </div>
    <p class="empty" data-empty hidden>沒有符合條件的新聞，換個條件試試。</p>

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/news/timeline/">照時間順序看：時間軸</a></li>
        <li><a href="/sources/">所有來源依類型列表</a></li>
        <li><a href="/basic/check/">我自己也有網站</a></li>
      </ul>
    </footer>
  </article>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-filters]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-wall] > .card')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  if (form && count && empty) {
    const update = () => {
      const f = new FormData(form);
      const lang = f.get('lang') as string;
      const group = f.get('group') as string;
      const tag = f.get('tag') as string;
      let shown = 0;
      for (const c of cards) {
        const ok =
          (!lang || c.dataset.lang === lang) &&
          (!group || c.dataset.group === group) &&
          (!tag || (c.dataset.tags ?? '').split('|').includes(tag));
        c.hidden = !ok;
        if (ok) shown++;
      }
      count.textContent = `顯示 ${shown}／${cards.length} 則`;
      empty.hidden = shown > 0;
    };
    form.addEventListener('change', update);
    form.addEventListener('reset', () => setTimeout(update));
    form.addEventListener('submit', (e) => e.preventDefault());
    form.hidden = false;
    update();
  }
</script>

<style>
  .page { display: grid; gap: 28px; max-width: 72rem; margin: 0 auto; padding: 40px var(--gutter) 64px; }
  .page__head { display: grid; gap: 12px; max-width: 46rem; }
  .kicker { font-size: 0.9375rem; font-weight: 700; color: var(--floor-ink-soft); }
  h1 { font-size: clamp(2rem, 6vw, 2.75rem); font-weight: 900; }
  .filters { display: flex; flex-wrap: wrap; align-items: end; gap: 12px 16px; }
  .filters[hidden] { display: none; }
  .filters label { display: grid; gap: 4px; font-size: 0.875rem; font-weight: 700; }
  .filters select, .filters button {
    min-height: 44px;
    padding: 6px 10px;
    border: 2px solid var(--graphite);
    border-radius: 4px;
    background: #fff;
    color: var(--floor-ink);
    font: inherit;
    font-size: 0.9375rem;
    max-width: 16rem;
  }
  .filters button { cursor: pointer; }
  .filters__count { flex-basis: 100%; font-size: 0.875rem; color: var(--floor-ink-soft); }
  .wall { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 16px; }
  .wall > :global([hidden]) { display: none; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); max-width: 46rem; }
  .next h2 { font-size: 1.25rem; }
  .next ul { margin: 0; padding-left: 1.2em; }
</style>
