---
import { getOrdered } from '../../lib/news';
import Base from '../../layouts/Base.astro';
import SourceLinks from '../../components/news/SourceLinks.astro';

const quotes = await getOrdered('quotes');
---
<Base title="名言錄" persona="news" description="PHP2Shell 事件中，維護團隊、研究者、資安業者與學者的關鍵發言，附出處。">
  <article class="page">
    <header class="page__head">
      <p class="kicker"><a href="/news/">吃瓜懶人包</a></p>
      <h1>名言錄</h1>
      <p>這幾天被轉最多次的句子。只收能對上原文或新聞摘要的；中文是編譯的會註明，有英文原句的一併附上。</p>
    </header>

    <ul class="quotes">
      {quotes.map(({ id, data: q }) => (
        <li id={id}>
          <figure class="quote">
            <blockquote>
              <p>{q.quote}</p>
              {q.quote_original && <p class="quote__orig" lang="en">{q.quote_original}</p>}
            </blockquote>
            <figcaption>
              <span class="quote__speaker">{q.speaker}</span>
              {q.role !== q.speaker && <span class="quote__role">{q.role}</span>}
            </figcaption>
            <SourceLinks refs={q.sources} />
          </figure>
        </li>
      ))}
    </ul>

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/news/story/">這些話是在什麼情境下說的？讀前因後果</a></li>
        <li><a href="/news/wall/">看完整新聞牆</a></li>
        <li><a href="/basic/check/">我自己也有網站</a></li>
      </ul>
    </footer>
  </article>
</Base>

<style>
  .page { display: grid; gap: 32px; max-width: 46rem; margin: 0 auto; padding: 40px var(--gutter) 64px; }
  .page__head { display: grid; gap: 12px; }
  .kicker { font-size: 0.9375rem; font-weight: 700; color: var(--floor-ink-soft); }
  h1 { font-size: clamp(2rem, 6vw, 2.75rem); font-weight: 900; }
  .quotes { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .quote { display: grid; gap: 10px; margin: 0; padding: 20px 20px 16px; background: #fff; border-left: 6px solid var(--line-news); border-radius: 4px; }
  blockquote { display: grid; gap: 8px; margin: 0; }
  blockquote > p:first-child { font-size: 1.25rem; font-weight: 700; line-height: 1.55; }
  .quote__orig { color: var(--floor-ink-soft); font-size: 0.9375rem; font-style: italic; }
  figcaption { display: flex; flex-wrap: wrap; gap: 2px 10px; }
  .quote__speaker { font-weight: 800; }
  .quote__role { color: var(--floor-ink-soft); font-size: 0.9375rem; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); }
  .next h2 { font-size: 1.25rem; }
  .next ul { margin: 0; padding-left: 1.2em; }
</style>
