---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventTime from '../../components/news/EventTime.astro';
import { getOrdered, languageLabel, newsTitle, referencesNews } from '../../lib/news';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const title = newsTitle(entry);
const related = (await getOrdered('timeline')).filter((e) => referencesNews(e.data.sources, entry));
const precisionNote = { exact: '原文標到時分', approximate: '時刻為約略', 'date-only': '原文只標日期' }[d.time_precision];
---
<Base title={title} persona="news" description={`${d.source}：${title}（本站摘要與原文連結）`}>
  <article class="page">
    <header class="page__head">
      <p class="kicker"><a href="/news/wall/">新聞牆</a></p>
      <h1>{title}</h1>
      {d.title_zh && <p class="orig" lang={d.language}>{d.title}</p>}
      <dl class="meta">
        <div><dt>來源</dt><dd>{d.source}{d.author && d.author !== d.source && `（${d.author}）`}</dd></div>
        <div><dt>類型</dt><dd>{d.source_type}</dd></div>
        <div><dt>台灣時間</dt><dd class="num">{d.published_at_taipei}<span class="soft">（{precisionNote}）</span></dd></div>
        <div><dt>原始時間</dt><dd class="num">{d.published_at}</dd></div>
        {d.updated_at && <div><dt>原文更新</dt><dd class="num">{d.updated_at}</dd></div>}
        <div><dt>語言</dt><dd>{languageLabel(d.language)}</dd></div>
      </dl>
      {d.time_note && <p class="note">時間註記：{d.time_note}</p>}
      {d.fetch_status === 'failed' && (
        <p class="flag" role="note"><strong>未取得全文。</strong>本站沒有讀到這則的正文，下面只寫標題與日期等可以確認的內容。</p>
      )}
      <p><a class="cta" href={d.url} rel="noopener">閱讀原文<span class="visually-hidden">（{d.source}，另開外部網站）</span></a></p>
    </header>

    <div class="body">
      <Content />
    </div>

    {d.tags.length > 0 && (
      <ul class="tags" aria-label="標籤">{d.tags.map((t) => <li>{t}</li>)}</ul>
    )}

    {related.length > 0 && (
      <section class="related">
        <h2>這則新聞撐起的時間軸事件</h2>
        <ul>
          {related.map((e) => (
            <li>
              <EventTime at={e.data.at} precision={e.data.precision} />
              <a href={`/news/timeline/#${e.id}`}>{e.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/news/wall/">回新聞牆看其他報導</a></li>
        <li><a href="/news/rumors/">各家說法不一致的地方</a></li>
        <li><a href="/basic/check/">我自己也有網站</a></li>
      </ul>
    </footer>
  </article>
</Base>

<style>
  .page { display: grid; gap: 28px; max-width: 46rem; margin: 0 auto; padding: 40px var(--gutter) 64px; }
  .page__head { display: grid; gap: 12px; }
  .kicker { font-size: 0.9375rem; font-weight: 700; color: var(--floor-ink-soft); }
  h1 { font-size: clamp(1.625rem, 5vw, 2.25rem); font-weight: 900; line-height: 1.3; }
  .orig { color: var(--floor-ink-soft); }
  .meta { display: grid; gap: 4px; margin: 0; font-size: 0.9375rem; }
  .meta div { display: flex; gap: 12px; }
  .meta dt { flex: 0 0 5em; font-weight: 700; }
  .meta dd { margin: 0; }
  .soft { color: var(--floor-ink-soft); font-size: 0.875rem; }
  .note { font-size: 0.9375rem; color: var(--floor-ink-soft); }
  .flag { padding: 10px 14px; border-left: 4px solid var(--alert); background: #fff; }
  .cta {
    display: inline-block;
    padding: 10px 18px;
    background: var(--graphite);
    color: var(--on-graphite);
    border-radius: 4px;
    font-weight: 700;
    text-decoration: none;
  }
  .body { display: grid; gap: 16px; }
  .body :global(h2) { font-size: 1.25rem; margin-top: 8px; }
  .body :global(ul), .body :global(ol) { margin: 0; padding-left: 1.3em; }
  .body :global(li + li) { margin-top: 6px; }
  .body :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 0.9375rem; }
  .body :global(th), .body :global(td) { padding: 6px 10px; border: 1px solid var(--graphite-rule); text-align: left; vertical-align: top; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; font-size: 0.875rem; }
  .tags li { padding: 0 10px; background: #fff; border-radius: 999px; }
  .related { display: grid; gap: 10px; }
  .related h2, .next h2 { font-size: 1.25rem; }
  .related ul { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .related li { display: grid; gap: 2px; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); }
  .next ul { margin: 0; padding-left: 1.2em; }
</style>
