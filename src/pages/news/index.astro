---
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import TimelineList from '../../components/news/TimelineList.astro';
import { facts } from '../../lib/data';
import { getNews } from '../../lib/news';

const news = await getNews();
const latest = news.slice(0, 5);
const ref = (file: string) => `/news/${file.replace(/\.md$/, '')}/`;

// 數字看板：每個數字來源不同、母體不同，不能相加（見 /news/rumors/#host-counts）
const board = [
  { value: facts.php_share.value, label: '已知伺服器端語言的網站裡，使用 PHP 的比例', note: `${facts.php_share.source}。不是「網際網路的七成」。`, href: '/news/rumors/#seventy-percent' },
  { value: '近 5,500 萬', label: '當天看到跑著 PHP 的網路資產', note: 'Censys，經 NBC 報導', href: ref('2026-10-21-2106-nbcnews-critical-vulnerabilities-rush-to-update.md') },
  { value: '約 2,260 萬', label: '暴露在網路上、可能受影響的實例', note: 'Cortex Xpanse 估計', href: ref('2026-10-21-unit42-php-threat-brief.md') },
  { value: '59%', label: '有回報版本號的約 150 萬台主機中，跑的是拿不到官方修補的版本', note: 'Mallory 統計，經 CyberQ 報導', href: ref('2026-10-21-0852-cyberq-php-core-rce-leak.md') },
  { value: '近 200 個檔', label: '這次修補動到的檔案，程式碼超過一萬行', note: '鉅亨網編譯《華爾街日報》', href: ref('2026-10-21-2240-cnyes-php-emergency-patch-heartbleed.md') },
];
const versions = facts.fixed.map((f) => f.version).join('、');
---
<Base title="PHP2Shell 吃瓜懶人包" persona="news" description="PHP2Shell 事件懶人包：一句話看懂、數字看板、最新新聞與時間軸精華。">
  <article class="page">
    <header class="masthead">
      <div class="masthead__text">
        <p class="kicker">吃瓜懶人包 · 資料更新 <span class="num">{facts.updated_at}</span></p>
        <h1>PHP2Shell 到底發生什麼事？</h1>
        <p class="lede">撐起全球大量網站的 PHP，被找到兩個能讓外人遠端在伺服器上執行程式的嚴重漏洞（{facts.cves.map((c) => c.id).join('、')}，CVSS {facts.cves[0].cvss_v4}）。消息在修補前就先外洩，官方提前在台灣時間 10 月 21 日晚上 10 點推出修補（{versions}），多國政府與企業網站先關站避險。</p>
      </div>
      <ImageSlot id="news-hub" loading="eager" />
    </header>

    <nav aria-label="吃瓜區頁面" class="sections">
      <a href="/news/story/"><strong>前因後果</strong><span>從 2004 年講到全球關站</span></a>
      <a href="/news/timeline/"><strong>時間軸</strong><span>UTC／台灣時間對照</span></a>
      <a href="/news/wall/"><strong>新聞牆</strong><span>{news.length} 則摘要，可篩選</span></a>
      <a href="/news/outages/"><strong>關站名單</strong><span>誰關了、為什麼</span></a>
      <a href="/news/quotes/"><strong>名言錄</strong><span>這幾天被轉最多的話</span></a>
      <a href="/news/rumors/"><strong>說法打架</strong><span>各家講不一樣的地方</span></a>
    </nav>

    <section aria-labelledby="board-t" class="block">
      <h2 id="board-t">數字看板</h2>
      <p class="soft">這五個數字常在標題裡輪流出現，但它們數的不是同一件事，<strong>不要加總</strong>。</p>
      <ul class="board">
        {board.map((b) => (
          <li>
            <p class="board__value num">{b.value}</p>
            <p class="board__label">{b.label}</p>
            <p class="board__note"><a href={b.href}>{b.note}</a></p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="latest-t" class="block">
      <h2 id="latest-t">最新五則</h2>
      <div class="latest">
        {latest.map((entry) => <NewsCard entry={entry} />)}
      </div>
      <p><a href="/news/wall/">看全部 {news.length} 則新聞</a></p>
    </section>

    <section aria-labelledby="tl-t" class="block block--narrow">
      <h2 id="tl-t">時間軸精華</h2>
      <p class="soft">時間為原始來源標示；只有日期的不補時分。</p>
      <TimelineList highlightsOnly />
      <p><a href="/news/timeline/">看完整時間軸（可切換 UTC／台灣時間）</a></p>
    </section>

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/basic/check/">我自己也有網站，要怎麼確認？</a></li>
        <li><a href="/news/story/">花五分鐘讀完前因後果</a></li>
        <li><a href="/dev/">我是工程師，給我修補步驟</a></li>
      </ul>
    </footer>
  </article>
</Base>

<style>
  .page { display: grid; gap: 40px; max-width: 72rem; margin: 0 auto; padding: 40px var(--gutter) 64px; }
  .masthead { display: grid; gap: 20px; align-items: center; padding-bottom: 24px; border-bottom: 4px double var(--graphite); }
  @media (min-width: 56rem) { .masthead { grid-template-columns: 3fr 2fr; } }
  .masthead__text { display: grid; gap: 14px; }
  .kicker { font-size: 0.9375rem; font-weight: 700; color: var(--floor-ink-soft); }
  h1 { font-size: clamp(2.125rem, 7vw, 3.5rem); font-weight: 900; }
  .lede { font-size: 1.1875rem; max-width: 40rem; }
  .sections { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: 10px; }
  .sections a { display: grid; gap: 2px; padding: 12px 16px; background: #fff; border-left: 5px solid var(--line-news); border-radius: 4px; text-decoration: none; }
  .sections a:hover strong { text-decoration: underline; }
  .sections span { font-size: 0.875rem; color: var(--floor-ink-soft); }
  .block { display: grid; gap: 14px; }
  .block--narrow { max-width: 46rem; }
  .block h2, .next h2 { font-size: 1.5rem; font-weight: 900; }
  .soft { color: var(--floor-ink-soft); }
  .board { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .board li { display: grid; gap: 6px; align-content: start; padding: 16px; background: var(--graphite); color: var(--on-graphite); border-radius: 4px; }
  .board__value { font-size: 2rem; font-weight: 900; line-height: 1.1; }
  .board__label { font-size: 0.9375rem; }
  .board__note { font-size: 0.8125rem; color: var(--on-graphite-soft); }
  .latest { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 16px; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); max-width: 46rem; }
  .next ul { margin: 0; padding-left: 1.2em; }
</style>
