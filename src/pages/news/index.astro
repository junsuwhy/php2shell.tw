---
import CampaignLanding from '../../components/CampaignLanding.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { getNews, newsHref, newsTitle } from '../../lib/news';

const news = await getNews();
const latest = news[0];
const sections = [
  { href: '/news/story/', id: 'news-sec-story', title: '前因後果' },
  { href: '/news/timeline/', id: 'news-sec-timeline', title: '時間軸' },
  { href: '/news/wall/', id: 'news-sec-wall', title: '新聞牆' },
  { href: '/news/outages/', id: 'news-sec-outages', title: '關站名單' },
  { href: '/news/quotes/', id: 'news-sec-quotes', title: '名言錄' },
  { href: '/news/rumors/', id: 'news-sec-rumors', title: '說法打架' },
];
---
<CampaignLanding
  persona="news"
  title="PHP2Shell 到底發生什麼事？"
  description="兩個 PHP 漏洞、消息外洩、提前修補、全球關站。"
  hero="news-hub"
  heading="PHP2Shell 到底發生什麼事？"
  compact
>
  <p slot="sub">兩個 PHP 漏洞 → 消息外洩 → 提前修補 → 全球關站</p>
  <div slot="body" class="news-actions">
    <nav aria-label="吃瓜區頁面" class="sections">
      {sections.map((s) => (
        <a class="sec" href={s.href} aria-labelledby={`${s.id}-label`}>
          <ImageSlot id={s.id} class="sec__img" framed={false} />
          <span class="sec__title" id={`${s.id}-label`}>{s.title}</span>
        </a>
      ))}
    </nav>
    <a class="brief" href="/news/brief/">懶人包</a>
  </div>
  {latest && (
    <div slot="strip" class="ticker">
      <a class="ticker__lead" href={newsHref(latest)}>
        <span class="ticker__k">最新：</span>
        <span class="ticker__viewport">
          <span class="ticker__track">
            <span class="ticker__title">{newsTitle(latest)}</span>
            <span class="ticker__title" aria-hidden="true">{newsTitle(latest)}</span>
          </span>
        </span>
      </a>
      <a class="ticker__wall" href="/news/wall/">看新聞牆</a>
    </div>
  )}
</CampaignLanding>

<style>
  .news-actions {
    max-width: 72rem;
    margin: 0 auto;
    padding: 16px var(--gutter) 8px;
  }
  .sections { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .sec {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 4px;
    background: #2a2228;
    color: #fff;
    text-decoration: none;
  }
  .sec :global(.sec__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sec__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 36px 14px 14px;
    background: linear-gradient(transparent, rgb(14 16 20 / 0.88) 38%, rgb(14 16 20 / 0.94) 100%);
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 900;
    line-height: 1.25;
  }
  .sec:hover .sec__title,
  .sec:focus-visible .sec__title { text-decoration: underline; text-underline-offset: 0.18em; }
  .sec:hover { outline: 3px solid var(--line-news); outline-offset: 3px; }
  .sec:focus-visible { outline: 3px solid var(--line-news); outline-offset: 3px; }
  @media (min-width: 48rem) {
    .sections { grid-template-columns: 1fr 1fr 1fr; }
  }
  .brief {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    margin-top: 12px;
    padding: 16px 20px;
    border-radius: 4px;
    /* 粉紅路線色略加白，深字才過 4.5:1。 */
    background: color-mix(in srgb, var(--line-news) 86%, #fff);
    color: var(--on-line);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .brief:hover,
  .brief:focus-visible {
    outline: 3px solid var(--graphite);
    outline-offset: 4px;
    filter: brightness(1.05);
  }

  .ticker {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 48px;
    margin-top: 20px;
    padding: 0 var(--gutter);
    overflow: hidden;
    background: var(--graphite);
    color: #fff;
    border-top: 4px solid var(--line-news);
  }
  .ticker__lead {
    display: flex;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
    flex: 1;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }
  .ticker__k { flex: none; }
  .ticker__viewport { overflow: hidden; min-width: 0; flex: 1; }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 22s linear infinite;
  }
  .ticker__title { padding-right: 3rem; white-space: nowrap; }
  .ticker__lead:hover .ticker__track,
  .ticker__lead:focus-visible .ticker__track { animation-play-state: paused; }
  .ticker__wall {
    flex: none;
    color: #fff;
    font-weight: 800;
    white-space: nowrap;
  }
  .ticker a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .ticker a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none !important; }
    .ticker__title[aria-hidden='true'] { display: none; }
    .ticker__title {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      padding-right: 0;
    }
  }
</style>
