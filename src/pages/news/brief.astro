---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/news/NewsCard.astro';
import TimelineList from '../../components/news/TimelineList.astro';
import { facts, releaseTime as r } from '../../lib/data';
import { findNews, getNews, newsHref } from '../../lib/news';

const news = await getNews();
const latest = news.slice(0, 5);
const ref = (file: string) => newsHref(findNews(news, file));

// 數字看板：每個數字來源不同、母體不同，不能相加
const board = [
  { value: facts.php_share.value, label: '已知伺服器端語言的網站裡，使用 PHP 的比例', note: `${facts.php_share.source}。不是「網際網路的七成」。` },
  { value: '近 5,500 萬', label: '當天看到跑著 PHP 的網路資產', note: 'Censys，經 NBC 報導', href: ref('2026-10-21-2106-nbcnews-critical-vulnerabilities-rush-to-update.md') },
  { value: '約 2,260 萬', label: '暴露在網路上、可能受影響的實例', note: 'Cortex Xpanse 估計', href: ref('2026-10-21-unit42-php-threat-brief.md') },
];
const versions = facts.fixed.map((f) => f.version).join('、');
---
<Base title="懶人包" persona="news" description="PHP2Shell 事件懶人包：一句話看懂、數字看板、最新新聞與時間軸精華。">
  <header class="brief-head">
    <h1>懶人包</h1>
    <p class="lede">撐起全球大量網站的 PHP，被找到兩個能讓外人遠端在伺服器上執行程式的嚴重漏洞（{facts.cves.map((c) => c.id).join('、')}，CVSS {facts.cves[0].cvss_v4}）。消息在修補前就先外洩，官方提前在台灣時間 <span class="num">{r.month}</span> 月 <span class="num">{r.day}</span> 日{r.taipei.part} <span class="num">{r.taipei.hour}</span> 點{r.taipei.minute > 0 && <> <span class="num">{r.taipei.minute}</span> 分</>}推出修補（{versions}），多國政府與企業網站先關站避險。</p>
  </header>
  <article class="page">
    <section aria-labelledby="board-t" class="block">
      <h2 id="board-t">數字看板</h2>
      <p class="soft">這三個數字常在標題裡輪流出現，但它們數的不是同一件事，<strong>不要加總</strong>。</p>
      <ul class="board">
        {board.map((b) => (
          <li>
            <p class="board__value num">{b.value}</p>
            <p class="board__label">{b.label}</p>
            <p class="board__note">{b.href ? <a href={b.href}>{b.note}</a> : b.note}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="latest-t" class="block">
      <h2 id="latest-t">最新五則</h2>
      <div class="latest">
        {latest.map((entry) => <NewsCard entry={entry} />)}
      </div>
      <p><a href="/news/wall/">看全部 {news.length} 則新聞</a></p>
    </section>

    <section aria-labelledby="tl-t" class="block block--narrow">
      <h2 id="tl-t">時間軸精華</h2>
      <p class="soft">時間為原始來源標示；只有日期的不補時分。</p>
      <TimelineList highlightsOnly />
      <p><a href="/news/timeline/">看完整時間軸（可切換 UTC／台灣時間）</a></p>
    </section>

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/basic/act/#q1">我自己也有網站，要怎麼確認？</a></li>
        <li><a href="/dev/">我是工程師，給我修補步驟</a></li>
      </ul>
    </footer>
  </article>
</Base>

<style>
  .brief-head,
  .page { max-width: 72rem; margin: 0 auto; }
  .brief-head { padding: 32px var(--gutter) 0; }
  .page { display: grid; gap: 40px; padding: 28px var(--gutter) 64px; }
  h1 { font-size: clamp(2.125rem, 7vw, 3.5rem); font-weight: 900; }
  .lede { margin-top: 12px; font-size: 1.1875rem; max-width: 40rem; }
  .block { display: grid; gap: 14px; }
  .block--narrow { max-width: 46rem; }
  .block h2, .next h2 { font-size: 1.5rem; font-weight: 900; }
  .soft { color: var(--floor-ink-soft); }
  .board { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 12.5rem), 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
  .board li { display: grid; gap: 6px; align-content: start; padding: 16px; background: var(--graphite); color: var(--on-graphite); border-radius: 4px; }
  .board__value { font-size: 2rem; font-weight: 900; line-height: 1.1; }
  .board__label { font-size: 0.9375rem; }
  .board__note { font-size: 0.8125rem; color: var(--on-graphite-soft); }
  .latest { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: 16px; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); max-width: 46rem; }
  .next ul { margin: 0; padding-left: 1.2em; }
</style>
