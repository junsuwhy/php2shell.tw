---
import { getOrdered } from '../../lib/news';
import Base from '../../layouts/Base.astro';
import SourceLinks from '../../components/news/SourceLinks.astro';
import { facts } from '../../lib/data';

const items = await getOrdered('discrepancies');
const pending = items.filter((i) => i.data.pending).length;
---
<Base title="常見誤傳與說法不一" persona="news" description="PHP2Shell 事件中各家說法不一致或仍待查證的地方，並列各說法與來源。">
  <article class="page">
    <header class="page__head">
      <h1>常見誤傳與說法不一</h1>
      <p>同一件事，不同來源講得不一樣。這頁把各家說法<strong>並排放著</strong>，再附上官方或較可信的說法當對照；對照不是裁判，其他說法不會因此被刪掉。</p>
      <p>共 <span class="num">{items.length}</span> 題，其中 <span class="num">{pending}</span> 題截至 <span class="num">{facts.updated_at}</span> 仍待查證。看到下面這些說法被講得很滿時，先別急著轉。</p>
    </header>

    <ul class="items">
      {items.map(({ id, data: d }) => (
        <li id={id}>
          <section class="item" aria-labelledby={`${id}-t`}>
            <div class="item__head">
              <h2 id={`${id}-t`}>{d.topic}</h2>
              {d.pending && <span class="item__pending">待查證</span>}
            </div>
            <div class="item__grid">
              <div class="claims">
                <h3>各家說法</h3>
                <ul>
                  {d.claims.map((c) => (
                    <li>
                      <p class="claims__text">{c.claim}</p>
                      <p class="claims__by">{c.by}</p>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="assess">
                <h3>官方或較可信的說法（對照）</h3>
                <p>{d.assessment}</p>
              </div>
            </div>
            {d.sources.length > 0 && <SourceLinks refs={d.sources} />}
          </section>
        </li>
      ))}
    </ul>

    <section class="open">
      <h2>本站刻意不下結論的事</h2>
      <ul>
        <li>10 月 17 日的行為者是誰、如何在禁運期間得知利用方式：AWS 寫明不知道。</li>
        <li>早期 PoC 在真實網站上的成功率：AWS 寫明分析仍在進行。</li>
        <li>個別關站的網站是否已經遭到入侵：Mashable 與多國政府的說法都是預防性下線，沒有公開的「已被竊取資料清單」。</li>
      </ul>
    </section>

    <footer class="next">
      <h2>下一步</h2>
      <ul>
        <li><a href="/sources/">所有來源列表</a></li>
        <li><a href="/basic/check/">我自己也有網站</a></li>
      </ul>
    </footer>
  </article>
</Base>

<style>
  .page { display: grid; gap: 32px; max-width: 60rem; margin: 0 auto; padding: 40px var(--gutter) 64px; }
  .page__head { display: grid; gap: 12px; max-width: 46rem; }
  h1 { font-size: clamp(2rem, 6vw, 2.75rem); font-weight: 900; }
  .items { display: grid; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .item { display: grid; gap: 12px; padding: 18px; background: #fff; border-radius: 4px; }
  .item__head { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .item__head h2 { font-size: 1.25rem; }
  .item__pending { padding: 0 8px; border: 1px solid var(--alert); border-radius: 3px; color: var(--alert); font-size: 0.875rem; font-weight: 700; }
  .item__grid { display: grid; gap: 16px; }
  @media (min-width: 48rem) { .item__grid { grid-template-columns: 1fr 1fr; } }
  .item h3 { font-size: 0.9375rem; color: var(--floor-ink-soft); margin-bottom: 6px; }
  .claims ul { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .claims li { padding-left: 12px; border-left: 3px solid var(--line-news); }
  .claims__text { font-weight: 700; }
  .claims__by { font-size: 0.875rem; color: var(--floor-ink-soft); }
  .assess { padding: 10px 14px; background: var(--floor); border-radius: 4px; }
  .open { display: grid; gap: 8px; }
  .open h2, .next h2 { font-size: 1.25rem; }
  .open ul, .next ul { margin: 0; padding-left: 1.2em; }
  .next { display: grid; gap: 8px; padding-top: 24px; border-top: 2px solid var(--graphite); }
</style>
