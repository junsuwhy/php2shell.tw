---
// 開發者區文章版型：給 src/pages/dev/**/*.mdx 用（frontmatter 的 layout）。
// 固定輸出：標題與導言、正文、來源與查詢日期、下一步（有寫才出現）。
// 正文由 MDX 產生，樣式以 .dev-doc 底下的 :global() 套用，不新增全域樣式。
import Base from './Base.astro';
import HeroBanner from '../components/HeroBanner.astro';

interface Source { title: string; url: string }
interface Next { href: string; label: string; note?: string }

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    lede?: string;
    hero?: string;
    checked: string;
    sources: Source[];
    next?: Next[];
  };
}

const { title, description, lede, hero, checked, sources, next = [] } = Astro.props.frontmatter;
---
<Base title={title} description={description} persona="dev">
  {hero ? (
    <HeroBanner id={hero} variant="dev">
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </HeroBanner>
  ) : (
    <header class="dev-title">
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
  )}
  <article class:list={['dev-doc', { 'dev-doc--after-hero': Boolean(hero) }]}>
    <div class="dev-doc__body">
      <slot />
    </div>

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">來源</h2>
      <p class="sources__checked">查詢日期：<time class="num" datetime={checked}>{checked}</time>。官方公告優先列出；內容如與 PHP 官方公告不一致，以官方公告為準。</p>
      <ul>
        {sources.map((s) => (
          <li><a href={s.url} rel="noopener">{s.title}</a></li>
        ))}
      </ul>
    </section>

    {next.length > 0 && (
      <nav class="next" aria-labelledby="next-title">
        <h2 id="next-title">下一步</h2>
        <ul>
          {next.map((n) => (
            <li>
              <a href={n.href}>{n.label}</a>
              {n.note && <span class="next__note">{n.note}</span>}
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
</Base>

<style>
  .dev-title,
  .dev-doc {
    max-width: 46rem;
    margin: 0 auto;
  }
  .dev-title { padding: 32px var(--gutter) 0; }
  .dev-doc { padding: 8px var(--gutter) 56px; }
  .dev-doc--after-hero { padding-top: 28px; }
  h1 { font-size: var(--fs-display); font-weight: 900; }
  .lede { margin-top: 12px; font-size: var(--fs-lead); color: var(--floor-ink-soft); }
  :global(.start) { display: grid; gap: 12px; margin-top: 8px; }
  :global(.start ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  :global(.start a) {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    border: 2px solid var(--graphite);
    border-radius: 4px;
    background: #fff;
    text-decoration: none;
  }
  :global(.start a:hover),
  :global(.start a:focus-visible) { border-color: var(--line-dev); }
  :global(.start strong) { font-size: var(--fs-lead); }
  :global(.start span) { font-size: var(--fs-small); color: var(--floor-ink-soft); }

  .dev-doc__body { margin-top: 28px; }
  .dev-doc__body :global(h2) {
    margin: 2.5rem 0 0.75rem;
    padding-top: 0.5rem;
    border-top: 3px solid var(--line-dev);
    font-size: var(--fs-heading);
    font-weight: 800;
  }
  .dev-doc__body :global(h3) { margin: 1.75rem 0 0.5rem; font-size: var(--fs-lead); font-weight: 800; }
  .dev-doc__body :global(p) { margin: 0.75rem 0; }
  .dev-doc__body :global(ul),
  .dev-doc__body :global(ol) { margin: 0.75rem 0; padding-left: 1.5rem; }
  .dev-doc__body :global(li + li) { margin-top: 0.35rem; }
  .dev-doc__body :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 3px;
    background: #d8dce1;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    /* 例外：等寬字看起來較大，用相對值跟著所在段落或標題縮放 */
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }
  .dev-doc__body :global(blockquote:not(.glossary-note)) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--alert);
    background: #fff;
  }
  .dev-doc__body :global(.glossary-note) { background: transparent; }
  .dev-doc__body :global(.glossary-note[open]) { background: #f4f5f6; }
  .dev-doc__body :global(table) {
    display: block;
    overflow-x: auto;
    width: 100%;
    margin: 1rem 0;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .dev-doc__body :global(th),
  .dev-doc__body :global(td) { padding: 8px 10px; border-bottom: 1px solid #c9cdd3; text-align: left; vertical-align: top; }
  .dev-doc__body :global(thead th) { background: var(--graphite); color: var(--on-graphite); }

  .sources, .next { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--graphite-rule); }
  .sources h2, .next h2 { font-size: var(--fs-lead); font-weight: 800; }
  .sources__checked { margin: 0.5rem 0; font-size: var(--fs-small); color: var(--floor-ink-soft); }
  .sources ul { padding-left: 1.25rem; font-size: var(--fs-small); overflow-wrap: anywhere; }
  .next ul { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 10px; }
  .next a {
    display: inline-block;
    padding: 10px 16px;
    min-height: 44px;
    border: 2px solid var(--graphite);
    border-radius: 4px;
    font-weight: 700;
    text-decoration: none;
  }
  .next a:hover { background: var(--line-dev); color: var(--on-line); }
  .next__note { display: block; margin-top: 4px; font-size: var(--fs-small); color: var(--floor-ink-soft); }
</style>
