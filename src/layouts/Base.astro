---
import '@fontsource-variable/noto-sans-tc';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import AreaNav from '../components/AreaNav.astro';
import TransferMenu from '../components/TransferMenu.astro';
import { facts, site } from '../lib/data';
import { getSlot } from '../lib/images';
import type { PersonaId } from '../data/personas';

export type Persona = 'gateway' | PersonaId;

interface Props {
  title: string;
  description?: string;
  persona: Persona;
}

const { title, description = `${facts.name} 事件，依身份說清楚。`, persona } = Astro.props;
const current = persona === 'gateway' ? undefined : persona;
// 已經以網站名稱結尾（例如首頁自訂的完整標題）就不再加後綴
const fullTitle = title === site.title || title.endsWith(`｜${site.title}`) ? title : `${title}｜${site.title}`;
const og = getSlot('og-default');
const ogImage = og.ready ? new URL(og.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang={site.lang} data-persona={persona}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#22262c" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{site.title}</a>
      <TransferMenu current={current} />
    </header>
    {current && <AreaNav persona={current} pathname={Astro.url.pathname} />}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="網站資訊">
        <a href="/about/">關於本站</a>
        <a href="/sources/">資料來源</a>
        {site.contact_email && <a href={`mailto:${site.contact_email}`}>聯絡站長</a>}
      </nav>
      {site.social && site.social.length > 0 && (
        <nav aria-label="社群帳號">
          {site.social.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={`${site.title} 的 ${s.name}（另開新視窗）`}>{s.name}</a>
          ))}
        </nav>
      )}
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px var(--gutter);
    background: var(--graphite);
    color: var(--on-graphite);
  }
  .site-name {
    font-weight: 900;
    font-size: 1.125rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 28px var(--gutter) 40px;
    background: var(--graphite);
    color: var(--on-graphite-soft);
    font-size: 0.9375rem;
  }
  .site-footer nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .site-footer a { color: var(--on-graphite); }
</style>
